---
import {designs, activeDesignId, designPath, mainSitePath} from '../lib/designs'

const pathname = Astro.url.pathname
const active = activeDesignId(pathname)
---

<nav class="design-switcher" aria-label="Design previews">
	<a
		class="ds-item ds-home"
		href={mainSitePath(pathname)}
		aria-current={active === null ? 'page' : undefined}
		title="Current site"
	>
		<i class="i-tabler:home text-[0.85em]" aria-hidden="true"></i>
		<span class="sr-only">Current site</span>
	</a>
	<span class="ds-divider" aria-hidden="true"></span>
	{designs.map((design) => (
		<a
			class="ds-item"
			href={designPath(design.id, pathname)}
			aria-current={active === design.id ? 'page' : undefined}
			title={`${design.name} — ${design.tagline}`}
		>
			{design.id}
			<span class="sr-only">{`: ${design.name}`}</span>
		</a>
	))}
</nav>

<style>
	.design-switcher {
		position: fixed;
		bottom: max(1rem, env(safe-area-inset-bottom));
		left: 50%;
		transform: translateX(-50%);
		z-index: 100;
		display: flex;
		align-items: center;
		gap: 0.25rem;
		padding: 0.375rem;
		border-radius: var(--ds-radius, 999px);
		font-family: var(
			--ds-font,
			ui-sans-serif,
			system-ui,
			-apple-system,
			sans-serif
		);
		font-size: 0.8125rem;
		line-height: 1;
		background: var(--ds-bg, rgba(23, 23, 26, 0.82));
		color: var(--ds-fg, rgba(255, 255, 255, 0.72));
		border: 1px solid var(--ds-border, rgba(255, 255, 255, 0.14));
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		box-shadow: 0 0.25rem 1.5rem rgba(0, 0, 0, 0.25);
	}

	.ds-item {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 1.875rem;
		height: 1.875rem;
		border-radius: var(--ds-item-radius, 999px);
		color: inherit;
		text-decoration: none;
		font-variant-numeric: tabular-nums;
		transition: background-color 150ms ease, color 150ms ease;
	}

	.ds-item:hover {
		background: var(--ds-hover-bg, rgba(255, 255, 255, 0.12));
		color: var(--ds-hover-fg, #fff);
	}

	.ds-item[aria-current='page'] {
		background: var(--ds-accent, #fff);
		color: var(--ds-accent-fg, #17171a);
		font-weight: 600;
	}

	.ds-item:focus-visible {
		outline: 2px solid var(--ds-accent, #fff);
		outline-offset: 2px;
	}

	.ds-divider {
		width: 1px;
		height: 1rem;
		margin: 0 0.125rem;
		background: var(--ds-border, rgba(255, 255, 255, 0.14));
	}

	@media (prefers-reduced-motion: reduce) {
		.ds-item {
			transition: none;
		}
	}

	@media print {
		.design-switcher {
			display: none;
		}
	}
</style>
