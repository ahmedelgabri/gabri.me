---
import {starPoints} from './geometry'

interface Props {
	size?: number
	class?: string
}

const {size = 12, class: className} = Astro.props

const points = starPoints(12, 12, 10)
---

<svg
	class={className}
	width={size}
	height={size}
	viewBox="0 0 24 24"
	aria-hidden="true"
>
	<polygon
		points={points}
		fill="none"
		stroke="currentColor"
		stroke-width="1"
		vector-effect="non-scaling-stroke"
	/>
</svg>
