---
/*
 * The footer keeps an instrument. A planispheric astrolabe drawn out of its own
 * projection rather than traced: the plate is cut for the latitude this site is
 * written at, the rete carries ten real stars in their real places, and the sky
 * creeps round at 360× its own rate until somebody takes hold of it.
 */
const wiki = 'https://en.wikipedia.org/wiki'
---

<figure class="zj-astrolabe">
	{/* The whole box is the handle: the rete turns wherever you take hold of it */}
	<div class="zj-astrolabe-plate" data-zj-astrolabe></div>

	<figcaption class="zj-astrolabe-note">
		<span class="zj-astrolabe-honest"
			>star places approximate · plate cut for 52.4°N · the rete creeps at 360×
			the sky’s own rate<span class="zj-astrolabe-hint"> — take hold of it</span
			></span
		>
		<span>
			An <a href={`${wiki}/Astrolabe`} target="_blank" rel="noopener">astrolabe</a
			> is the sky worked in brass: the half-dome overhead flattened by stereographic
			projection onto a plate cut for one latitude, with a pierced rete of star pointers
			turning over it to give the hour, the season and the height of anything you
			can sight. It was the working instrument of the <a
				href={`${wiki}/Astronomy_in_the_medieval_Islamic_world`}
				target="_blank"
				rel="noopener">astronomers of the medieval Islamic world</a
			>, who timed the prayers and found the direction of Mecca by it: <a
				href={`${wiki}/Al-Zarqali`}
				target="_blank"
				rel="noopener">al-Zarqālī</a
			> of eleventh-century Toledo cut a plate that served every latitude at once,
			and <a href={`${wiki}/Al-%CA%BBIjliyyah`} target="_blank" rel="noopener"
				>al-ʻIjliyyah</a
			> was making astrolabes at the court of Aleppo a century before him.
		</span>
	</figcaption>
</figure>

<style is:global>
	/* ————— The footer instrument ————— */

	/*
	 * The instrument is the footer's content rather than its ornament, so it is
	 * drawn at every width and takes the reading column for its own. The one
	 * thing it cannot do is be described and not arrive — a caption for an
	 * instrument that is not there is worse than no instrument. The reservation
	 * rides on zj-js, which lands before the first paint, so the common case
	 * never shifts the copyright line; the two failing cases below fold the
	 * figure away at script time, long before the footer is scrolled to.
	 */
	.design-zellij .zj-astrolabe {
		display: none;
	}

	.design-zellij.zj-js .zj-astrolabe {
		display: block;
		/*
		 * The column is the only limit worth measuring against — the page frame
		 * has already taken its padding out of it — and 420px is where a disc
		 * drawn in hairlines stops gaining anything from more room.
		 */
		width: min(420px, 100%);
		margin: 0.25rem auto 2.25rem;
	}

	/* No WebGL, or a chunk that never came */
	.design-zellij.zj-astrolabe-off .zj-astrolabe {
		display: none;
	}

	.design-zellij .zj-astrolabe-plate {
		position: relative;
		/* The instrument is a disc; a wider box would only be dead handle */
		aspect-ratio: 1;
	}

	.design-zellij .zj-astrolabe-plate[data-held] {
		cursor: grabbing;
	}

	.design-zellij .zj-astrolabe-plate canvas {
		position: absolute;
		inset: 0;
		display: block;
		/* Struck rather than faded in: a transition from a fresh node never runs */
		animation: zj-astrolabe-in 700ms ease-out both;
	}

	@keyframes zj-astrolabe-in {
		from {
			opacity: 0;
		}
	}

	.design-zellij .zj-astrolabe-hint {
		display: none;
	}

	/*
	 * A finger has no way to turn the rete — the touch pointers are ignored so
	 * the page can still be scrolled past an instrument that fills the column —
	 * so the invitation to turn it is only extended to a pointer that can. The
	 * rete turns on its own regardless, so a finger is shown the same motion.
	 */
	@media (hover: hover) and (pointer: fine) {
		.design-zellij .zj-astrolabe-plate {
			cursor: grab;
		}

		.design-zellij .zj-astrolabe-hint {
			display: inline;
		}
	}

	/* The object label under the object: set as a block, not as footer chrome */
	.design-zellij .zj-astrolabe-note {
		max-width: 58ch;
		margin-inline: auto;
		text-align: left;
		font-size: 0.8125rem;
		line-height: 1.65;
	}

	.design-zellij .zj-astrolabe-honest {
		display: block;
		margin-bottom: 0.5rem;
		font-family: var(--z-font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.05em;
	}
</style>

<script>
	import type {Color, LineBasicMaterial as LineMaterial} from 'three'
	import type {Lifecycle} from './frames'
	import {FULL_RATE, createLayerLifecycle} from './frames'
	import {starVertices} from './geometry'
	import {DARK, LIGHT} from './ink'
	import {RAD, epochDays, sunLongitude} from './moon'
	import {
		between,
		createPixelStage,
		createThemeFade,
		fitPixels,
		hasWebGL,
		loadThree,
	} from './webgl'

	/* A plate is cut for one latitude and one only; this one is Amsterdam's */
	const LATITUDE = 52.37 * RAD
	const LONGITUDE = 4.9
	const OBLIQUITY = 23.4393 * RAD
	/*
	 * Everything is built in unit space, where 1 is the outer edge of the limb,
	 * and scaled to the box on resize. The plate inside the degree ring is the
	 * tropic of Capricorn, and in the stereographic projection that one radius
	 * fixes every other: the equator and the tropic of Cancer follow from it.
	 */
	const LIMB = 1
	const PLATE = 0.9
	const EQUATOR = PLATE / Math.tan(Math.PI / 4 + OBLIQUITY / 2)
	const CANCER = EQUATOR * Math.tan(Math.PI / 4 - OBLIQUITY / 2)
	/* Altitudes to carve into the plate; the horizon carries structure weight */
	const ALMUCANTARS = [0, 20, 40, 60]
	/* The sky's own rate is one turn a day — this is the same motion at 360× */
	const SIDEREAL = (Math.PI * 2) / 240
	/* Per second: how quickly a spun rete gives its speed up and takes the creep back */
	const SETTLE = 0.55
	/* A rete under a finger lags it by a hair. The plate is brass, not a cursor */
	const FOLLOW = 18
	/* The rule is a separate limb of the instrument and swings after the sun mark */
	const RULE_FOLLOW = 1.6
	/* Fast enough to feel thrown, slow enough that the ring never strobes */
	const MAX_SPIN = 14
	/*
	 * An instrument of at most 420px drawn in hairlines. Three device pixels to
	 * two CSS ones still resolves every one of them and asks the machine for
	 * little over half the fragments a fourth would — which the phones with
	 * three device pixels to one CSS pixel feel more sharply than any desktop.
	 */
	const MAX_RATIO = 1.5
	/*
	 * The creep at this rate turns an eighth of a degree a frame, which is
	 * four tenths of a pixel out at the limb — under the width of the line it
	 * is moving.
	 */
	const CREEP = 12
	/* Past twice the creep the ring would step visibly at that rate */
	const CALM = SIDEREAL * 2
	/* Long enough to reach the frame that can see the grab for itself */
	const GRAB = 0.2

	/*
	 * The two inks, light theme first. By night the instrument is brass on the
	 * indigo ground and both weights are --zj-gild. By day it is a plate printed
	 * in a manuscript: the figure itself in kohl, the way an engraving carries
	 * its main line, and the circles derived from it in the lapis a diagram
	 * keeps for its secondary work — a distinction the single gold cannot make.
	 */
	const STRUCTURE_INK = [LIGHT.text, DARK.gild]
	const ENGRAVED_INK = [LIGHT.geo, DARK.gild]
	/*
	 * Both plates are struck to the same weight on the page rather than to the
	 * same number: kohl at 0.7 holds 5.5:1 on the ivory where the night's gold
	 * holds 5.7:1 on the indigo, a hair under because dark ink on a light
	 * ground reads heavier than light ink on a dark one. The lapis is given a
	 * little more than the gold it answers to — 2.1:1 against 1.9:1 — because a
	 * cool hairline is the first thing ivory swallows.
	 */
	const STRUCTURE_ALPHA = [0.7, 0.82]
	const ENGRAVED_ALPHA = [0.4, 0.3]
	/* Seconds to re-ink when the page changes theme */
	const FADE = 0.3

	/* Set on <html> when the plate cannot be drawn, which folds the figure away */
	const OFF = 'zj-astrolabe-off'

	/*
	 * J2000 places, rounded to the arcminute — a real rete carries its own list
	 * and this is a short one. All ten lie north of the tropic of Capricorn,
	 * which is the southern limit of what any rete can reach: Fomalhaut and
	 * Antares fall off the edge of the instrument, not off this list.
	 */
	const STARS: Array<[string, number, number]> = [
		['Sirius', 6.752, -16.72],
		['Rigel', 5.242, -8.2],
		['Betelgeuse', 5.919, 7.41],
		['Altair', 19.846, 8.87],
		['Regulus', 10.14, 11.97],
		['Aldebaran', 4.599, 16.51],
		['Arcturus', 14.261, 19.18],
		['Vega', 18.616, 38.78],
		['Deneb', 20.69, 45.28],
		['Capella', 5.278, 46.0],
	]

	interface Ink {
		material: LineMaterial
		day: Color
		night: Color
		alpha: number[]
	}

	/* Which star sits on the meridian right now, in radians of right ascension */
	function siderealTime(days: number): number {
		const turned = (280.46061837 + 360.98564736629 * days + LONGITUDE) % 360

		return (turned < 0 ? turned + 360 : turned) * RAD
	}

	/* Clockwise from the top, in the renderer's y-down pixel space */
	function at(angle: number, radius: number): [number, number] {
		return [Math.sin(angle) * radius, -Math.cos(angle) * radius]
	}

	/*
	 * The projection the whole instrument is built on: the sphere seen from the
	 * south pole, dropped onto the plane of the equator. Declination becomes a
	 * radius, right ascension becomes an angle, and every circle in the sky
	 * stays a circle on the brass.
	 */
	function decRadius(dec: number): number {
		return EQUATOR * Math.tan((Math.PI / 2 - dec) / 2)
	}

	function push(out: number[], ax: number, ay: number, bx: number, by: number) {
		out.push(ax, ay, 0, bx, by, 0)
	}

	function chain(out: number[], points: Array<[number, number]>) {
		for (let i = 1; i < points.length; i++) {
			push(out, points[i - 1][0], points[i - 1][1], points[i][0], points[i][1])
		}
	}

	/* A circle as segments, cut where it runs off the plate as it is on brass */
	function arc(
		out: number[],
		cx: number,
		cy: number,
		r: number,
		clip = Infinity,
		steps = 160,
	) {
		let px = 0
		let py = 0
		let was = false

		for (let i = 0; i <= steps; i++) {
			const t = (i / steps) * Math.PI * 2
			const x = cx + Math.cos(t) * r
			const y = cy + Math.sin(t) * r
			const inside = Math.hypot(x, y) <= clip

			if (i > 0 && inside && was) {
				push(out, px, py, x, y)
			}

			px = x
			py = y
			was = inside
		}
	}

	/* The design's eight-point star, used here as the mark at a pointer's tip */
	function khatam(out: number[], cx: number, cy: number, r: number) {
		const points = starVertices(cx, cy, r)
		/* The walk is open; chained back to its first vertex it closes the star */
		chain(out, [...points, points[0]])
	}

	/*
	 * An almucantar — the circle of one altitude — is where the plate stops
	 * being a diagram of the sky and starts being a diagram of a place.
	 */
	function almucantar(out: number[], altitude: number) {
		const denominator = Math.sin(LATITUDE) + Math.sin(altitude)

		arc(
			out,
			0,
			(-EQUATOR * Math.cos(LATITUDE)) / denominator,
			(EQUATOR * Math.cos(altitude)) / denominator,
			PLATE,
		)
	}

	async function enhance(
		box: HTMLElement,
		onscreen: () => boolean,
	): Promise<Lifecycle> {
		const {
			BufferGeometry,
			Color,
			Float32BufferAttribute,
			Group,
			LineBasicMaterial,
			LineSegments,
		} = await loadThree()

		/* Pixel space with y running down, so a screen angle is a clockwise one */
		const {renderer, scene, camera} = await createPixelStage(box)

		let width = box.clientWidth
		let height = box.clientHeight

		const instrument = new Group()
		scene.add(instrument)

		const structure = new LineBasicMaterial({transparent: true})
		const engraved = new LineBasicMaterial({transparent: true})
		const inks: Ink[] = [
			{
				material: structure,
				day: new Color(STRUCTURE_INK[0]),
				night: new Color(STRUCTURE_INK[1]),
				alpha: STRUCTURE_ALPHA,
			},
			{
				material: engraved,
				day: new Color(ENGRAVED_INK[0]),
				night: new Color(ENGRAVED_INK[1]),
				alpha: ENGRAVED_ALPHA,
			},
		]

		function reink(amount: number) {
			for (const {material, day, night, alpha} of inks) {
				material.color.copy(day).lerp(night, amount)
				material.opacity = between(alpha, amount)
			}
		}

		function draw(values: number[], material: LineMaterial) {
			const geometry = new BufferGeometry()
			geometry.setAttribute('position', new Float32BufferAttribute(values, 3))
			return new LineSegments(geometry, material)
		}

		/* ————— The mater: the limb, its degree ring, and the plate inside it ————— */

		const heavy: number[] = []
		const light: number[] = []

		arc(heavy, 0, 0, LIMB)
		arc(heavy, 0, 0, PLATE)
		arc(light, 0, 0, 0.955)

		for (let degree = 0; degree < 360; degree += 5) {
			const long = degree % 30 === 0
			const [ox, oy] = at(degree * RAD, LIMB)
			const [ix, iy] = at(degree * RAD, long ? 0.925 : 0.955)
			push(long ? heavy : light, ox, oy, ix, iy)
		}

		arc(light, 0, 0, EQUATOR)
		arc(light, 0, 0, CANCER)
		/* The meridian, and the zenith of the latitude this plate was cut for */
		push(light, 0, -PLATE, 0, PLATE)
		khatam(
			light,
			0,
			(-EQUATOR * Math.cos(LATITUDE)) / (1 + Math.sin(LATITUDE)),
			0.016,
		)

		for (const altitude of ALMUCANTARS) {
			almucantar(altitude === 0 ? heavy : light, altitude * RAD)
		}

		instrument.add(draw(heavy, structure))
		instrument.add(draw(light, engraved))

		/* ————— The rete: the ecliptic band and its pierced star pointers ————— */

		const rete = new Group()
		instrument.add(rete)

		const rim: number[] = []
		const web: number[] = []
		/* The ecliptic touches Cancer at one solstice and Capricorn at the other */
		const eclipticRadius = (PLATE + CANCER) / 2
		const [ecx, ecy] = at(-18 * 15 * RAD, (PLATE - CANCER) / 2)
		const band = 0.06

		arc(rim, 0, 0, PLATE)
		arc(rim, ecx, ecy, eclipticRadius)
		arc(web, ecx, ecy, eclipticRadius - band)

		/*
		 * The twelve signs are equal along the ecliptic and unequal on the brass:
		 * each division is carried through declination and right ascension first,
		 * so the projection spaces them the way it really does.
		 */
		for (let sign = 0; sign < 12; sign++) {
			const longitude = sign * 30 * RAD
			const dec = Math.asin(Math.sin(OBLIQUITY) * Math.sin(longitude))
			const ra = Math.atan2(
				Math.cos(OBLIQUITY) * Math.sin(longitude),
				Math.cos(longitude),
			)
			const [px, py] = at(-ra, decRadius(dec))
			const dx = px - ecx
			const dy = py - ecy
			const length = Math.hypot(dx, dy) || 1
			push(web, px, py, px - (dx / length) * band, py - (dy / length) * band)
		}

		for (const [, hours, degrees] of STARS) {
			const [px, py] = at(-hours * 15 * RAD, decRadius(degrees * RAD))
			/* Every pointer sprouts off the ecliptic band, as it must to be one piece */
			const dx = px - ecx
			const dy = py - ecy
			const span = Math.hypot(dx, dy) || 1
			const ax = ecx + (dx / span) * eclipticRadius
			const ay = ecy + (dy / span) * eclipticRadius
			const reach = Math.hypot(px - ax, py - ay) || 1
			const flame = Math.min(reach, 0.15)
			const ux = (px - ax) / reach
			const uy = (py - ay) / reach
			const bx = px - ux * flame
			const by = py - uy * flame
			/* Half-width at the root, tapering to nothing at the star it names */
			const wide = 0.028
			const mx = bx + ux * flame * 0.5
			const my = by + uy * flame * 0.5

			push(web, ax, ay, bx, by)
			chain(rim, [
				[bx - uy * wide, by + ux * wide],
				[mx - uy * wide * 0.5, my + ux * wide * 0.5],
				[px, py],
				[mx + uy * wide * 0.5, my - ux * wide * 0.5],
				[bx + uy * wide, by - ux * wide],
			])
			khatam(rim, px, py, 0.017)
		}

		/* Where the sun stands on the ecliptic today, which is what the rule reads */
		const today = epochDays(new Date())
		const solar = sunLongitude(today)
		const sunDec = Math.asin(Math.sin(OBLIQUITY) * Math.sin(solar))
		const sunRa = Math.atan2(
			Math.cos(OBLIQUITY) * Math.sin(solar),
			Math.cos(solar),
		)
		const [sx, sy] = at(-sunRa, decRadius(sunDec))
		khatam(rim, sx, sy, 0.03)

		rete.add(draw(rim, structure))
		rete.add(draw(web, engraved))

		/* ————— The rule, laid over everything and pointing at the sun ————— */

		const bar: number[] = []
		push(bar, 0, -LIMB, 0, LIMB)

		for (let i = 1; i < 6; i++) {
			const y = (i / 6) * EQUATOR
			push(bar, -0.018, -y, 0.018, -y)
			push(bar, -0.018, y, 0.018, y)
		}

		const rule = draw(bar, structure)
		instrument.add(rule)

		/* The rete starts where the sky actually stands over Amsterdam right now */
		const sunAngle = -sunRa
		let angle = siderealTime(today)
		let ruleAngle = angle + sunAngle
		let spin = SIDEREAL
		let grab: {pointer: number; raw: number; target: number} | null = null

		const fade = createThemeFade(FADE, () => {
			/* Off screen there is no cross-fade to see: take the new ink whole */
			if (!onscreen()) {
				fade.snap()
				reink(fade.amount)
			}

			life.settle()
		})

		reink(fade.amount)

		/*
		 * Where the box stood when the hand took hold of it. A rect is a layout
		 * read, and asking for one on every move of the pointer is asking for
		 * one on every frame of the turn.
		 */
		let bounds = box.getBoundingClientRect()

		function pointerAngle(event: PointerEvent): number {
			/* Clockwise from the top, to match the angles the rete is built on */
			return Math.atan2(
				event.clientX - (bounds.left + bounds.width / 2),
				bounds.top + bounds.height / 2 - event.clientY,
			)
		}

		function step(delta: number): boolean {
			if (fade.step(delta)) {
				reink(fade.amount)
			}

			if (grab === null) {
				/* A spun rete gives its speed up slowly and finds the creep again */
				spin += (SIDEREAL - spin) * (1 - Math.exp(-SETTLE * delta))
				angle += spin * delta
			} else {
				const previous = angle
				angle += (grab.target - angle) * (1 - Math.exp(-FOLLOW * delta))
				/*
				 * The release carries the rete's own speed rather than the
				 * pointer's, so a flicked cursor cannot throw the brass faster
				 * than it was ever actually turning.
				 */
				const rate = delta > 0 ? (angle - previous) / delta : spin
				spin = Math.max(-MAX_SPIN, Math.min(MAX_SPIN, rate))
			}

			ruleAngle +=
				(angle + sunAngle - ruleAngle) * (1 - Math.exp(-RULE_FOLLOW * delta))

			/* The sky never stops turning, so no frame here is ever a repeat */
			return true
		}

		function paint() {
			rete.rotation.z = angle
			rule.rotation.z = ruleAngle
			renderer.render(scene, camera)
		}

		/*
		 * A rete under a hand, and one still giving up the speed it was thrown
		 * at, both turn far faster than the sky does and want every frame until
		 * they are back to the creep.
		 */
		function fps(): number {
			if (
				grab !== null ||
				fade.amount !== fade.target ||
				Math.abs(spin - SIDEREAL) > CALM
			) {
				return FULL_RATE
			}

			return CREEP
		}

		/* Unlike the page's other layers this one scrolls away, and then it stops */
		const life = createLayerLifecycle({
			step,
			paint,
			awake: onscreen,
			fps,
			counter: 'astrolabe',
		})

		function resize() {
			const next = box.clientWidth
			const tall = box.clientHeight

			/* A box that has been folded away, or is not yet laid out, measures 0 */
			if (next === 0 || tall === 0) {
				return
			}

			width = next
			height = tall
			bounds = box.getBoundingClientRect()
			fitPixels(renderer, camera, width, height, MAX_RATIO)
			instrument.position.set(width / 2, height / 2, 0)
			instrument.scale.setScalar(Math.min(width, height) * 0.45)
		}

		box.addEventListener('pointerdown', (event) => {
			/* A finger has to be able to scroll past the instrument, not turn it */
			if (event.pointerType === 'touch') {
				return
			}

			box.setPointerCapture(event.pointerId)
			box.setAttribute('data-held', '')
			bounds = box.getBoundingClientRect()
			grab = {pointer: event.pointerId, raw: pointerAngle(event), target: angle}
			/* The creep is on a slow timer; a hand on the brass must not wait for it */
			life.boost(GRAB)
		})

		box.addEventListener('pointermove', (event) => {
			if (grab === null || event.pointerId !== grab.pointer) {
				return
			}

			/* Accumulated rather than absolute, so crossing the top is not a jump */
			const raw = pointerAngle(event)
			let turn = raw - grab.raw

			while (turn > Math.PI) {
				turn -= Math.PI * 2
			}

			while (turn < -Math.PI) {
				turn += Math.PI * 2
			}

			grab.raw = raw
			grab.target += turn
		})

		function release(event: PointerEvent) {
			if (grab === null || event.pointerId !== grab.pointer) {
				return
			}

			grab = null
			box.removeAttribute('data-held')
		}

		box.addEventListener('pointerup', release)
		box.addEventListener('pointercancel', release)

		new ResizeObserver(resize).observe(box)
		resize()
		box.appendChild(renderer.domElement)

		return life
	}

	function gate(box: HTMLElement) {
		let onscreen = false
		let started = false
		let life: Lifecycle | null = null

		/* Nothing is fetched, and nothing runs, until the footer is reached */
		new IntersectionObserver(
			(entries) => {
				onscreen = entries[entries.length - 1].isIntersecting

				if (onscreen && !started) {
					started = true
					enhance(box, () => onscreen)
						.then((ready) => {
							life = ready
							ready.settle()
						})
						.catch(() => {
							document.documentElement.classList.add(OFF)
						})
				}

				life?.settle()
			},
			{threshold: 0},
		).observe(box)
	}

	const box = document.querySelector<HTMLElement>('[data-zj-astrolabe]')

	if (box) {
		if (hasWebGL()) {
			gate(box)
		} else {
			document.documentElement.classList.add(OFF)
		}
	}
</script>
