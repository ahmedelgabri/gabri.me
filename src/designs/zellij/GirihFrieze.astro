---
import {starPoints, crossPoints} from './geometry'

/*
 * Star-and-cross band. Khatam stars sit on a square lattice with spacing
 * 2√2·a (a = half-side of the generating squares), which makes neighbouring
 * stars touch tip to tip, and the leftover gaps on the half-lattice are
 * exactly the cross tiles. Cropping that tiling to a single row of stars
 * leaves half-crosses along both edges of the band — the classic frieze.
 */
const unit = 40
const a = unit / (2 * Math.SQRT2)
const r = unit / 2
const count = 26
const width = count * unit

/* Every star sits on the lattice; every cross on the half-lattice between them */
const centres = Array.from({length: count}, (_, i) => i * unit + r)
const crosses = Array.from({length: count + 1}, (_, i) => i * unit).flatMap(
	(x) => [
		{x, y: 0},
		{x, y: unit},
	],
)
---

<svg
	class="zj-frieze"
	viewBox={`0 0 ${width} ${unit}`}
	preserveAspectRatio="xMidYMid slice"
	aria-hidden="true"
>
	{/*
	 * One tile of each kind, drawn about the origin and placed by every
	 * instance's own x/y. The ink rides on the instances rather than on these:
	 * a stylesheet cannot reach inside a use's shadow tree, but stroke and its
	 * dash properties are inherited, so what the <use> carries the shape draws.
	 */}
	<defs>
		<polygon id="zj-tile-star" points={starPoints(0, 0, r)} pathLength="1" />
		<polygon id="zj-tile-cross" points={crossPoints(0, 0, r)} pathLength="1" />
		<rect
			id="zj-tile-square"
			x={-a}
			y={-a}
			width={2 * a}
			height={2 * a}
			pathLength="1"
		/>
	</defs>
	{crosses.map(({x, y}) => (
		<use class="zj-frieze-cross" href="#zj-tile-cross" x={x} y={y} />
	))}
	{centres.map((cx) => (
		<Fragment>
			<use class="zj-frieze-square" href="#zj-tile-square" x={cx} y={r} />
			<use
				class="zj-frieze-square"
				href="#zj-tile-square"
				x={cx}
				y={r}
				transform={`rotate(45 ${cx} ${r})`}
			/>
			<use class="zj-frieze-star" href="#zj-tile-star" x={cx} y={r} />
		</Fragment>
	))}
</svg>
