	}

	.design-zellij body {
		margin: 0;
		background: var(--zj-ground);
		color: var(--zj-text);
		font-family: var(--z-font-body);
		font-size: 1.0625rem;
		line-height: 1.75;
		/* Bottom padding keeps the fixed design switcher clear of the footer */
		padding: clamp(0.875rem, 3vw, 2.5rem) clamp(0.875rem, 3vw, 2rem) 6.5rem;
		-webkit-font-smoothing: antialiased;
		transition:
			background-color 300ms ease,
			color 300ms ease;
	}

	.design-zellij ::selection {
		background: var(--zj-selection);
	}

	.design-zellij :focus-visible {
		outline: 2px solid var(--zj-accent);
		outline-offset: 3px;
	}

	/* ————— The mashrabiya screen behind the carpet page ————— */

	.design-zellij body::before,
	.design-zellij body::after {
		content: '';
		position: fixed;
		z-index: -1;
		pointer-events: none;
		display: none;
	}

	@media (min-width: 75em) {
		.design-zellij body::before {
			display: block;
			inset: 0;
			background-image: var(--zj-screen);
			background-repeat: repeat;
			background-size: 240px 240px;
			background-position: 0 0;
			opacity: var(--zj-screen-opacity);
			/* The lattice dies away before it reaches the reading column */
			-webkit-mask-image: linear-gradient(
				to right,
				#000 0,
				#000 calc(50% - 31rem),
				transparent calc(50% - 25rem),
				transparent calc(50% + 25rem),
				#000 calc(50% + 31rem),
				#000 100%
			);
			mask-image: linear-gradient(
				to right,
				#000 0,
				#000 calc(50% - 31rem),
				transparent calc(50% - 25rem),
				transparent calc(50% + 25rem),
				#000 calc(50% + 31rem),
				#000 100%
			);
			animation: zj-drift 360s linear infinite;
		}
	}

	/*
	 * One marginal shamsa in the left whitespace, sitting exactly where the
	 * lattice above has already faded out, so the two never fight.
	 */
	@media (min-width: 96em) {
		.design-zellij body::after {
			display: block;
			top: 50%;
			right: calc(50% + 25rem);
			width: 20rem;
			height: 20rem;
			transform: translateY(-50%);
			background-image: var(--zj-medallion);
			background-repeat: no-repeat;
			background-size: contain;
			opacity: var(--zj-medallion-opacity);
		}
	}

	/* Exactly one tile, so the loop point is invisible; 360s keeps the old pace */
	@keyframes zj-drift {
		to {
			background-position: 240px 240px;
		}
	}

	/* ————— The carpet-page frame ————— */

	.design-zellij .zj-page {
		position: relative;
		max-width: 47rem;
		margin: 0 auto;
		border: 1px solid var(--zj-gild);
		outline: 1px solid var(--zj-hairline);
		outline-offset: 4px;
		/* The top margin also has to clear the theme toggle in the corner */
		padding: clamp(2.85rem, 4vw, 3.25rem) var(--zj-page-pad-x) 2.25rem;
		background: var(--zj-ground);
		transition:
			background-color 300ms ease,
			border-color 300ms ease;
	}

	.design-zellij .zj-corner {
		position: absolute;
		display: block;
		color: var(--zj-gild);
	}

	.design-zellij .zj-corner polygon {
		fill: var(--zj-ground);
	}

	.design-zellij .zj-corner-tl {
		top: -3px;
		left: -3px;
		transform: translate(-50%, -50%);
	}

	.design-zellij .zj-corner-tr {
		top: -3px;
		right: -3px;
		transform: translate(50%, -50%);
	}

	.design-zellij .zj-corner-bl {
		bottom: -3px;
		left: -3px;
		transform: translate(-50%, 50%);
	}

	.design-zellij .zj-corner-br {
		bottom: -3px;
		right: -3px;
		transform: translate(50%, 50%);
	}

	/* ————— Theme toggle ————— */

	.design-zellij .zj-theme-toggle {
		display: none;
		position: absolute;
		top: 0.5rem;
		right: 0.5rem;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		padding: 0;
		border: none;
		background: none;
		color: var(--zj-gild);
		cursor: pointer;
		transition: color 300ms ease;
	}

	.design-zellij.zj-js .zj-theme-toggle {
		display: flex;
	}

	/* The glyph names the theme the button switches TO: crescent by day, star by night */
	.design-zellij .zj-toggle-glyph {
		position: absolute;
		display: block;
		transition:
			opacity 300ms ease,
			transform 300ms ease;
	}

	.design-zellij.light .zj-toggle-sun,
	.design-zellij.dark .zj-toggle-moon {
		opacity: 0;
		transform: rotate(-90deg) scale(0.6);
	}

	.design-zellij.light .zj-toggle-moon,
	.design-zellij.dark .zj-toggle-sun {
		opacity: 1;
		transform: none;
	}

	.design-zellij.light .zj-theme-toggle:hover .zj-toggle-moon,
	.design-zellij.dark .zj-theme-toggle:hover .zj-toggle-sun {
		transform: rotate(15deg);
	}

	.design-zellij .zj-toggle-label {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* ————— Masthead ————— */

	.design-zellij .zj-masthead {
		text-align: center;
	}

	.design-zellij .zj-name {
		margin: 0;
		font-family: var(--z-font-display);
		font-weight: 700;
		font-size: clamp(2.1rem, 6vw, 3.15rem);
		line-height: 1.2;
		letter-spacing: 0.01em;
	}

	.design-zellij .zj-name a {
		color: inherit;
		text-decoration: none;
	}

	.design-zellij .zj-name a:hover {
		color: var(--zj-accent);
	}

	.design-zellij .zj-name-ar {
		margin: 0.1rem 0 0;
		font-family: var(--z-font-arabic);
		font-size: clamp(1.15rem, 3vw, 1.5rem);
		line-height: 1.7;
		color: var(--zj-accent);
	}

	.design-zellij .zj-role {
		margin: 0.7rem 0 0;
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		color: var(--zj-text-muted);
	}

	.design-zellij .zj-masthead-compact .zj-name {
		font-size: 1.55rem;
	}

	.design-zellij .zj-masthead-compact .zj-name-ar {
		font-size: 1.05rem;
	}

	/* ————— Girih frieze band ————— */

	.design-zellij .zj-frieze-band {
		margin: 1.4rem calc(-1 * var(--zj-page-pad-x)) 0;
		border-block: 1px solid var(--zj-hairline);
		line-height: 0;
	}

	.design-zellij .zj-frieze {
		display: block;
		width: 100%;
		height: 40px;
		fill: none;
	}

	.design-zellij .zj-frieze-star {
		stroke: var(--zj-geo);
		stroke-width: 1.2;
	}

	.design-zellij .zj-frieze-square {
		stroke: var(--zj-gild);
		stroke-width: 0.75;
		opacity: 0.6;
	}

	/* Gold on indigo carries 0.6 easily; bronze on ivory needs the extra weight */
	.design-zellij.light .zj-frieze-square {
		opacity: 0.8;
	}

	.design-zellij .zj-frieze-cross {
		stroke: var(--zj-geo);
		stroke-width: 1;
		opacity: 0.35;
	}

	.design-zellij .zj-frieze polygon,
	.design-zellij .zj-frieze rect {
		stroke-dasharray: 1;
		stroke-dashoffset: 0;
		animation: zj-draw 1.2s cubic-bezier(0.4, 0, 0.2, 1) backwards;
	}

	@keyframes zj-draw {
		from {
			stroke-dashoffset: 1;
		}
	}

	/* ————— Links ————— */

	.design-zellij a {
		color: var(--zj-accent);
		text-decoration: underline;
		text-decoration-color: var(--zj-underline-rest);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.16em;
		transition:
			text-decoration-color 150ms ease,
			color 150ms ease;
	}

	.design-zellij a:hover {
		text-decoration-color: var(--zj-gild);
		text-decoration-thickness: 2px;
	}

	/* Every link that leaves the site says so, in chrome and in prose alike */
	.design-zellij a[target='_blank']::after {
		content: '';
		display: inline-block;
		width: 0.6em;
		height: 0.6em;
		margin-left: 0.22em;
		vertical-align: 0.08em;
		/* The mark is a mask, so it takes the muted ink of whichever theme is on */
		background-color: var(--zj-text-muted);
		-webkit-mask-image: var(--zj-extlink);
		mask-image: var(--zj-extlink);
		-webkit-mask-size: 100% 100%;
		mask-size: 100% 100%;
		-webkit-mask-repeat: no-repeat;
		mask-repeat: no-repeat;
	}

	/* ————— Home sections ————— */

	.design-zellij .zj-main {
		padding-top: 2.25rem;
	}

	.design-zellij .zj-section {
		max-width: 68ch;
		margin-inline: auto;
	}

	.design-zellij .zj-section-title {
		margin: 0 0 1.3rem;
		font-family: var(--z-font-display);
		font-weight: 700;
		font-size: 1.55rem;
		line-height: 1.3;
		text-align: center;
	}

	.design-zellij .zj-lead {
		margin: 0 0 1.2em;
	}

	.design-zellij .zj-divider {
		display: flex;
		align-items: center;
		gap: 1.1rem;
		max-width: 68ch;
		margin: 2.6rem auto;
		color: var(--zj-gild);
	}

	.design-zellij .zj-divider::before,
	.design-zellij .zj-divider::after {
		content: '';
		flex: 1;
		border-top: 1px solid var(--zj-hairline);
	}

	.design-zellij .zj-divider svg {
		display: block;
		fill: none;
		stroke: currentColor;
		stroke-width: 1;
	}

	.design-zellij .zj-social {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.7rem;
		margin: 1.4rem 0 0;
		padding: 0;
		list-style: none;
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.design-zellij .zj-social a {
		text-decoration: none;
	}

	.design-zellij .zj-social a:hover {
		text-decoration: underline;
		text-decoration-color: var(--zj-gild);
	}

	/* ————— Entry lists ————— */

	.design-zellij .zj-entries {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.design-zellij .zj-entry {
		display: grid;
		grid-template-columns: 0.95rem 1fr;
		grid-template-areas:
			'star title'
			'.    date'
			'.    desc';
		column-gap: 0.85rem;
		row-gap: 0;
		padding-block: 0.7rem;
	}

	.design-zellij .zj-entry + .zj-entry {
		border-top: 1px solid var(--zj-rule);
	}

	.design-zellij .zj-entry-star {
		grid-area: star;
		margin-top: 0.55rem;
		color: var(--zj-gild);
	}

	.design-zellij .zj-entry-star svg {
		display: block;
		transform-origin: 50% 50%;
		transition: transform 200ms ease;
	}

	/* 22.5° is the khatam's own symmetry angle — the star lands on itself */
	.design-zellij .zj-entry:hover .zj-entry-star svg {
		transform: rotate(22.5deg);
	}

	.design-zellij .zj-entry-title {
		grid-area: title;
	}

	.design-zellij .zj-entry-title a {
		text-decoration: none;
		padding-bottom: 0.1em;
		background-image: linear-gradient(var(--zj-gild), var(--zj-gild));
		background-repeat: no-repeat;
		background-position: 0 100%;
		background-size: 0 1px;
		box-decoration-break: clone;
		-webkit-box-decoration-break: clone;
		transition: background-size 200ms ease;
	}

	.design-zellij .zj-entry:hover .zj-entry-title a,
	.design-zellij .zj-entry-title a:focus-visible {
		background-size: 100% 1px;
	}

	.design-zellij .zj-entry-date {
		grid-area: date;
		font-size: 0.9rem;
		color: var(--zj-text-muted);
		font-variant-numeric: oldstyle-nums;
		letter-spacing: 0.02em;
	}

	.design-zellij .zj-entry-desc {
		grid-area: desc;
		margin: 0;
		font-size: 0.9375rem;
		color: var(--zj-text-muted);
	}

	.design-zellij .zj-entry-extra {
		font-size: 0.9375rem;
		color: var(--zj-text-muted);
	}

	@media (min-width: 40em) {
		.design-zellij .zj-entry-dated {
			grid-template-columns: 0.95rem 6.5rem 1fr;
			grid-template-areas:
				'star date title'
				'.    .    desc';
			align-items: baseline;
		}

		.design-zellij .zj-entry-dated .zj-entry-star {
			align-self: start;
		}
	}

	/* ————— Article pages ————— */

	.design-zellij .zj-article {
		max-width: 68ch;
		margin-inline: auto;
	}

	.design-zellij .zj-article-header {
		text-align: center;
		margin-bottom: 2.5rem;
	}

	.design-zellij .zj-arch {
		display: block;
		width: min(100%, 26rem);
		height: auto;
		margin: 0 auto 1.1rem;
	}

	.design-zellij .zj-arch path {
		fill: none;
		stroke-dasharray: 1;
		stroke-dashoffset: 0;
		animation: zj-draw 0.9s cubic-bezier(0.4, 0, 0.2, 1) backwards;
	}

	.design-zellij .zj-arch-outer {
		stroke: var(--zj-geo);
		stroke-width: 2.25;
	}

	.design-zellij .zj-arch-inner {
		stroke: var(--zj-geo);
		stroke-width: 1;
		opacity: 0.5;
	}

	/* The imposts ground the arcs, so they land once the curve has been drawn */
	.design-zellij .zj-arch-impost {
		stroke: var(--zj-gild);
		stroke-width: 1.25;
		stroke-dasharray: 1;
		stroke-dashoffset: 0;
		animation: zj-draw 0.4s cubic-bezier(0.4, 0, 0.2, 1) 0.6s backwards;
	}

	.design-zellij .zj-article-kicker {
		margin: 0 0 0.5rem;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.26em;
		text-transform: uppercase;
		color: var(--zj-text-muted);
	}

	.design-zellij .zj-article-title {
		margin: 0;
		font-family: var(--z-font-display);
		font-weight: 700;
		font-size: clamp(1.7rem, 5vw, 2.4rem);
		line-height: 1.25;
	}

	.design-zellij .zj-article-meta {
		margin: 0.8rem 0 0;
		font-size: 0.9rem;
