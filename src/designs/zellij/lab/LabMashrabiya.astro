<div class="lab-demo" data-lab="b" data-ground="ivory"></div>

<style>
	/* Always the qishani ivory: this idea belongs to the light theme */
	.lab-demo {
		position: relative;
		width: 100%;
		aspect-ratio: 3 / 2;
		overflow: hidden;
		border-radius: 2px;
		background: #f5eedf;
	}

	/* The canvas is appended at runtime, so it never carries the scope attribute */
	.lab-demo :global(canvas) {
		display: block;
	}
</style>

<script>
	/* The sun through a screen, warm on plaster; never a flat gold overlay */
	const WARM = 0xc99228
	const GLARE = 0xfff3d8
	/* The contract's ceiling: light tints the ivory, it never paints over it */
	const PEAK = 0.16

	/*
	 * The gobo is the design's own star-and-cross girih — khatams on a square
	 * lattice of CELL with the cross tiles filling the half-lattice, the same
	 * tiling the masthead frieze is cropped out of. Only the strap between the
	 * tiles is solid; the tiles themselves are the openings.
	 */
	const CELL = 54
	const STRAP = 3.4
	/* The screen is never square to the floor */
	const TILT = 0.16

	function hasWebGL(): boolean {
		try {
			const probe = document.createElement('canvas')
			const context = probe.getContext('webgl2') ?? probe.getContext('webgl')
			/* Hand the context back rather than sitting on one of the browser's few */
			context?.getExtension('WEBGL_lose_context')?.loseContext()
			return Boolean(context)
		} catch {
			return false
		}
	}

	async function enhance(box: HTMLElement) {
		const {
			Color,
			Mesh,
			OrthographicCamera,
			PlaneGeometry,
			Scene,
			ShaderMaterial,
			Vector2,
			WebGLRenderer,
		} = await import('three')

		const renderer = new WebGLRenderer({alpha: true, antialias: false})
		renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2))
		renderer.domElement.setAttribute('aria-hidden', 'true')

		const scene = new Scene()
		/* The quad is written straight to clip space, so the camera only ticks the render */
		const camera = new OrthographicCamera(-1, 1, 1, -1, 0, 1)

		const material = new ShaderMaterial({
			transparent: true,
			depthTest: false,
			uniforms: {
				uSize: {value: new Vector2(1, 1)},
				uTime: {value: 0},
				uWarm: {value: new Color(WARM)},
				uGlare: {value: new Color(GLARE)},
				uPeak: {value: PEAK},
			},
			vertexShader: `
				varying vec2 vUv;

				void main() {
					vUv = uv;
					gl_Position = vec4(position.xy, 0.0, 1.0);
				}
			`,
			fragmentShader: `
				uniform vec2 uSize;
				uniform float uTime;
				uniform vec3 uWarm;
				uniform vec3 uGlare;
				uniform float uPeak;

				varying vec2 vUv;

				const float PI = 3.14159265;
				const float CELL = ${CELL.toFixed(1)};
				const float STRAP = ${STRAP.toFixed(2)};
				const float TILT = ${TILT.toFixed(3)};

				float sdBox(vec2 p, vec2 b) {
					vec2 d = abs(p) - b;
					return length(max(d, 0.0)) + min(max(d.x, d.y), 0.0);
				}

				vec2 turn(vec2 p, float a) {
					float c = cos(a);
					float s = sin(a);
					return vec2(c * p.x - s * p.y, s * p.x + c * p.y);
				}

				/*
				 * How much of the screen is open at p. The khatam is the union of
				 * two squares of half-side r/√2; the cross is the plus the same
				 * squares leave, with the four tips the neighbouring stars point
				 * into cut from the diamond of radius r.
				 */
				float openings(vec2 p, float soft) {
					float r = CELL * 0.5;
					float a = r / sqrt(2.0);
					float t = (sqrt(2.0) - 1.0) * a;

					vec2 qStar = mod(p, CELL) - r;
					vec2 qCross = mod(p + r, CELL) - r;

					float star = min(
						sdBox(qStar, vec2(a)),
						sdBox(turn(qStar, PI * 0.25), vec2(a))
					);
					float plus = min(sdBox(qCross, vec2(t, a)), sdBox(qCross, vec2(a, t)));
					float tips = max(
						sdBox(turn(qCross, PI * 0.25), vec2(r / sqrt(2.0))),
						-sdBox(qCross, vec2(a))
					);

					float d = min(star, min(plus, tips));
					return smoothstep(STRAP - soft, STRAP + soft, -d);
				}

				float pool(vec2 p, vec2 centre, vec2 reach) {
					return smoothstep(1.0, 0.12, length((p - centre) / reach));
				}

				void main() {
					vec2 p = vUv * uSize;
					float t = uTime;

					/* One screen, one sun: the whole gobo creeps as the angle changes */
					vec2 q = turn(p - vec2(t * 1.7, t * 0.55), TILT);

					vec2 c1 = uSize * vec2(
						0.30 + 0.14 * sin(t * 0.041),
						0.34 + 0.09 * cos(t * 0.033)
					);
					vec2 c2 = uSize * vec2(
						0.70 + 0.12 * cos(t * 0.027),
						0.62 + 0.10 * sin(t * 0.037)
					);
					vec2 c3 = uSize * vec2(
						0.52 + 0.17 * sin(t * 0.023 + 1.7),
						0.18 + 0.12 * cos(t * 0.031 + 0.6)
					);

					float e1 = pool(p, c1, uSize * vec2(0.42, 0.46))
						* (0.82 + 0.18 * sin(t * 0.31));
					float e2 = pool(p, c2, uSize * vec2(0.34, 0.40))
						* (0.80 + 0.20 * sin(t * 0.24 + 2.1));
					float e3 = pool(p, c3, uSize * vec2(0.26, 0.30))
						* (0.84 + 0.16 * sin(t * 0.37 + 4.0));

					float pooled = min(e1 + e2 * 0.85 + e3 * 0.7, 1.0);

					/* A sun patch is crisp at its core and soft at its rim */
					float soft = mix(4.2, 1.1, pooled);
					float light = openings(q, soft) * pooled;

					/* Some light finds its way in even where the screen blocks it */
					float total = min(light + pooled * 0.16, 1.0);

					vec3 tint = mix(uWarm, uGlare, pow(light, 3.0) * 0.5);
					gl_FragColor = vec4(tint, total * uPeak);
					#include <colorspace_fragment>
				}
			`,
		})

		const quad = new Mesh(new PlaneGeometry(2, 2), material)
		/* Its vertices ignore the camera, so it must not be judged against a frustum */
		quad.frustumCulled = false
		scene.add(quad)

		let elapsed = 0
		let last = 0
		let request = 0
		let running = false

		function frame(now: number) {
			/* A backgrounded tab can hand back a huge delta on the first frame */
			elapsed += Math.min((now - last) / 1000, 0.1)
			last = now
			material.uniforms.uTime.value = elapsed
			renderer.render(scene, camera)
			request = requestAnimationFrame(frame)
		}

		function start() {
			if (running) {
				return
			}

			running = true
			last = performance.now()
			request = requestAnimationFrame(frame)
		}

		function stop() {
			running = false
			cancelAnimationFrame(request)
		}

		function resize() {
			const width = box.clientWidth
			const height = box.clientHeight
			/* The ratio can change under the window, not only the size */
			renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2))
			renderer.setSize(width, height)
			material.uniforms.uSize.value.set(width, height)
			renderer.render(scene, camera)
		}

		window.addEventListener('resize', resize)

		resize()
		box.appendChild(renderer.domElement)

		return {start, stop}
	}

	const box = document.querySelector<HTMLElement>('[data-lab="b"]')

	if (box) {
		let api: {start(): void; stop(): void} | null = null
		let started = false
		let showing = false

		const settle = () => {
			if (!api) {
				return
			}

			if (showing && document.visibilityState === 'visible') {
				api.start()
			} else {
				api.stop()
			}
		}

		const observer = new IntersectionObserver(
			(entries) => {
				showing = entries[entries.length - 1].isIntersecting

				/* Nothing is fetched until the card is actually on screen */
				if (showing && !started) {
					started = true

					if (hasWebGL()) {
						enhance(box)
							.then((live) => {
								api = live
								settle()
							})
							/* A refused chunk leaves the plain ivory ground, which is no loss */
							.catch(() => undefined)
					}
				}

				settle()
			},
			{threshold: 0.25},
		)

		observer.observe(box)
		document.addEventListener('visibilitychange', settle)
	}
</script>
