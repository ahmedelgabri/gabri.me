<div class="lab-demo" data-lab="a" data-ground="follow"></div>

<style>
	.lab-demo {
		position: relative;
		width: 100%;
		aspect-ratio: 3 / 2;
		overflow: hidden;
		border-radius: 2px;
		background: var(--zj-ground);
		/* The lens is the whole point, so the box says it is a drawing surface */
		cursor: crosshair;
		transition: background-color 300ms ease;
	}

	/* The canvas is appended at runtime, so it never carries the scope attribute */
	.lab-demo :global(canvas) {
		display: block;
	}
</style>

<script>
	import {INNER_RATIO} from '../geometry'

	/*
	 * The lattice behind every zellij page, at its own scale — see "The
	 * background lattice" in DESIGNS.md. Rosette centres sit on a centred
	 * square lattice of 120, so a rosette of radius 120/√2 kisses its four
	 * diagonal neighbours, and the holes left over carry the strapwork.
	 */
	const CELL = 120
	const R = CELL / Math.SQRT2
	/* Where the {16/6} chords cut each other to make the petal valleys */
	const VALLEY =
		(R * Math.cos((6 * Math.PI) / 16)) / Math.cos((5 * Math.PI) / 16)
	/* The circumcircle of the 16-gon the {16/6}'s innermost intersections describe */
	const INNER = (R * Math.cos((6 * Math.PI) / 16)) / Math.cos(Math.PI / 16)
	/* Every one of the sixteen chords is tangent to this circle */
	const APOTHEM = R * Math.cos((6 * Math.PI) / 16)
	/* The free radius left in the lattice's holes */
	const HOLE = CELL - R
	/* The hole's star is {8/3} — sharper than the khatam's two squares */
	const HOLE_INNER = (HOLE * Math.cos((3 * Math.PI) / 8)) / Math.cos(Math.PI / 4)
	/* Half-width of the lozenge strap where it passes the mid-point */
	const STRAP_WAIST = 6
	const POINTS = 16
	/* The {16/6} step: each point is joined to the sixth from it */
	const STEP = 6

	const INK_LIGHT = 0x26221a
	const INK_DARK = 0xd9b44a
	/* Structure 1, infill 0.55 — the tile's own two weights, carried as alpha */
	const STRUCTURE = [0.55, 0.62]
	const INFILL = [0.3, 0.34]
	/* Pencil under ink: fainter than either inked weight, even at the lens centre */
	const PENCIL = [0.34, 0.4]
	const MARK = [0.5, 0.62]

	const LENS = 120
	const EASE = 0.08
	/* Seconds to cross-fade the ink when the page changes theme */
	const FADE = 0.3
	/* The lens wanders on its own until a pointer takes it over */
	const DRIFT = [0.21, 0.29]
	const DRIFT_REACH = 0.32

	type Point = [number, number]

	function ring(
		outer: number,
		inner: number,
		arms: number,
		phase: number,
	): Point[] {
		const points: Point[] = []

		for (let k = 0; k < arms * 2; k++) {
			const angle = phase + (k * Math.PI) / arms
			const radius = k % 2 === 0 ? outer : inner
			points.push([Math.cos(angle) * radius, Math.sin(angle) * radius])
		}

		return points
	}

	function circle(radius: number, steps: number): Point[] {
		return Array.from({length: steps}, (_, k) => {
			const angle = (k * Math.PI * 2) / steps
			return [Math.cos(angle) * radius, Math.sin(angle) * radius] as Point
		})
	}

	function loop(target: number[], points: Point[], cx: number, cy: number) {
		for (let i = 0; i < points.length; i++) {
			const from = points[i]
			const to = points[(i + 1) % points.length]
			target.push(cx + from[0], cy + from[1], 0, cx + to[0], cy + to[1], 0)
		}
	}

	function segment(
		target: number[],
		ax: number,
		ay: number,
		bx: number,
		by: number,
	) {
		target.push(ax, ay, 0, bx, by, 0)
	}

	/* The sixteen points stepped round the generating circle */
	function divisions(): Point[] {
		return Array.from({length: POINTS}, (_, k) => {
			const angle = (k * Math.PI * 2) / POINTS
			return [Math.cos(angle) * R, Math.sin(angle) * R] as Point
		})
	}

	function rosette(
		structure: number[],
		infill: number[],
		cx: number,
		cy: number,
	) {
		/* The ring of sixteen petals: tips at R, valleys where the chords cross */
		loop(structure, ring(R, VALLEY, POINTS, 0), cx, cy)
		/* The khatam inscribed in the innermost figure */
		loop(structure, ring(INNER, INNER * INNER_RATIO, 8, 0), cx, cy)
		/* The nested ring interlocking with the petals, half a step round */
		loop(infill, ring(VALLEY, INNER, POINTS, Math.PI / POINTS), cx, cy)
		loop(infill, circle(INNER, 72), cx, cy)
	}

	function hole(structure: number[], infill: number[], cx: number, cy: number) {
		loop(structure, ring(HOLE, HOLE_INNER, 8, 0), cx, cy)
		loop(infill, circle(HOLE_INNER, 48), cx, cy)

		/*
		 * Each diagonal tip launches a strap onto the tangency point where two
		 * rosettes kiss, waisted so neighbouring straps never chain into one
		 * straight diagonal across the plane.
		 */
		for (let k = 0; k < 4; k++) {
			const angle = Math.PI / 4 + (k * Math.PI) / 2
			const cos = Math.cos(angle)
			const sin = Math.sin(angle)
			const strap = [
				[HOLE, 0],
				[CELL / 2, STRAP_WAIST],
				[R, 0],
				[CELL / 2, -STRAP_WAIST],
			].map(
				([along, across]) =>
					[along * cos - across * sin, along * sin + across * cos] as Point,
			)

			loop(structure, strap, cx, cy)
		}
	}

	function construction(
		target: number[],
		marks: number[],
		cx: number,
		cy: number,
	) {
		/* The compass circle the whole figure is stepped round */
		loop(target, circle(R, 96), cx, cy)
		loop(target, circle(VALLEY, 96), cx, cy)
		loop(target, circle(INNER, 72), cx, cy)
		loop(target, circle(APOTHEM, 72), cx, cy)

		const points = divisions()

		for (let k = 0; k < POINTS; k++) {
			const from = points[k]
			const to = points[(k + STEP) % POINTS]
			segment(target, cx, cy, cx + from[0], cy + from[1])
			segment(target, cx + from[0], cy + from[1], cx + to[0], cy + to[1])
			marks.push(cx + from[0], cy + from[1], 0)
		}
	}

	/* Asked before three.js is fetched, so a machine without WebGL downloads nothing */
	function hasWebGL(): boolean {
		try {
			const probe = document.createElement('canvas')
			const context = probe.getContext('webgl2') ?? probe.getContext('webgl')
			/* Hand the context back rather than sitting on one of the browser's few */
			context?.getExtension('WEBGL_lose_context')?.loseContext()
			return Boolean(context)
		} catch {
			return false
		}
	}

	function between(pair: number[], amount: number): number {
		return pair[0] + (pair[1] - pair[0]) * amount
	}

	async function enhance(box: HTMLElement) {
		const {
			BufferGeometry,
			Color,
			Float32BufferAttribute,
			LineBasicMaterial,
			LineSegments,
			OrthographicCamera,
			Points,
			Scene,
			ShaderMaterial,
			Vector2,
			WebGLRenderer,
		} = await import('three')

		const renderer = new WebGLRenderer({alpha: true, antialias: true})
		renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2))
		renderer.domElement.setAttribute('aria-hidden', 'true')

		let width = box.clientWidth
		let height = box.clientHeight

		const scene = new Scene()
		/* Pixel space with y running down, so every constant above is a CSS pixel */
		const camera = new OrthographicCamera(0, width, 0, height, -1, 1)

		const inkLight = new Color(INK_LIGHT)
		const inkDark = new Color(INK_DARK)
		/* One colour instance, shared by every material and mutated in place */
		const ink = new Color()
		const lens = new Vector2()

		const structureMaterial = new LineBasicMaterial({transparent: true})
		const infillMaterial = new LineBasicMaterial({transparent: true})
		structureMaterial.color = ink
		infillMaterial.color = ink

		/*
		 * The pencil is drawn everywhere but only survives inside the lens: a
		 * distance test in the fragment shader, so nothing is rebuilt per frame.
		 */
		const pencilUniforms = {
			uLens: {value: lens},
			uRadius: {value: LENS},
			uColor: {value: ink},
			uOpacity: {value: 0},
		}

		const markUniforms = {
			uLens: {value: lens},
			uRadius: {value: LENS},
			uColor: {value: ink},
			uOpacity: {value: 0},
			uSize: {value: 3},
		}

		const pencilMaterial = new ShaderMaterial({
			transparent: true,
			uniforms: pencilUniforms,
			vertexShader: `
				varying vec2 vPlace;

				void main() {
					vPlace = position.xy;
					gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
				}
			`,
			fragmentShader: `
				uniform vec2 uLens;
				uniform float uRadius;
				uniform vec3 uColor;
				uniform float uOpacity;

				varying vec2 vPlace;

				void main() {
					/* Soft all the way out, so the lens never shows a rim */
					float lens = smoothstep(uRadius, uRadius * 0.25, distance(vPlace, uLens));
					gl_FragColor = vec4(uColor, lens * uOpacity);
					#include <colorspace_fragment>
				}
			`,
		})

		const markMaterial = new ShaderMaterial({
			transparent: true,
			uniforms: markUniforms,
			vertexShader: `
				uniform float uSize;

				varying vec2 vPlace;

				void main() {
					vPlace = position.xy;
					gl_PointSize = uSize;
					gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
				}
			`,
			fragmentShader: `
				uniform vec2 uLens;
				uniform float uRadius;
				uniform vec3 uColor;
				uniform float uOpacity;

				varying vec2 vPlace;

				void main() {
					float lens = smoothstep(uRadius, uRadius * 0.25, distance(vPlace, uLens));
					/* A bare point is a square; round the compass mark off */
					float mark = smoothstep(0.5, 0.28, length(gl_PointCoord - vec2(0.5)));
					gl_FragColor = vec4(uColor, lens * uOpacity * mark);
					#include <colorspace_fragment>
				}
			`,
		})

		const structureGeometry = new BufferGeometry()
		const infillGeometry = new BufferGeometry()
		const pencilGeometry = new BufferGeometry()
		const markGeometry = new BufferGeometry()

		scene.add(new LineSegments(structureGeometry, structureMaterial))
		scene.add(new LineSegments(infillGeometry, infillMaterial))
		scene.add(new LineSegments(pencilGeometry, pencilMaterial))
		scene.add(new Points(markGeometry, markMaterial))

		function upload(geometry: typeof structureGeometry, values: number[]) {
			/* The lattice is rebuilt on resize; free the old buffers first */
			geometry.dispose()
			geometry.setAttribute('position', new Float32BufferAttribute(values, 3))
		}

		function draw() {
			const structure: number[] = []
			const infill: number[] = []
			const pencil: number[] = []
			const marks: number[] = []

			/* A cell of overhang on every side, so no figure is cut at the box edge */
			const columns = Math.ceil(width / CELL) + 2
			const rows = Math.ceil(height / CELL) + 2
			const originX = (width - (columns - 1) * CELL) / 2
			const originY = (height - (rows - 1) * CELL) / 2

			for (let i = 0; i < columns; i++) {
				for (let j = 0; j < rows; j++) {
					const cx = originX + i * CELL
					const cy = originY + j * CELL

					if ((i + j) % 2 === 0) {
						rosette(structure, infill, cx, cy)
						construction(pencil, marks, cx, cy)
					} else {
						hole(structure, infill, cx, cy)
					}
				}
			}

			upload(structureGeometry, structure)
			upload(infillGeometry, infill)
			upload(pencilGeometry, pencil)
			upload(markGeometry, marks)
		}

		let lensX = width / 2
		let lensY = height / 2
		let targetX = lensX
		let targetY = lensY
		let pointer = false
		let amount = window.__zjTheme === 'dark' ? 1 : 0
		let target = amount
		let elapsed = 0
		let last = 0
		let request = 0
		let running = false

		function paint() {
			ink.copy(inkLight).lerp(inkDark, amount)
			structureMaterial.opacity = between(STRUCTURE, amount)
			infillMaterial.opacity = between(INFILL, amount)
			pencilUniforms.uOpacity.value = between(PENCIL, amount)
			markUniforms.uOpacity.value = between(MARK, amount)
			lens.set(lensX, lensY)
			renderer.render(scene, camera)
		}

		function frame(now: number) {
			/* A backgrounded tab can hand back a huge delta on the first frame */
			const delta = Math.min((now - last) / 1000, 0.1)
			last = now
			elapsed += delta

			const step = delta / FADE
			amount =
				target > amount
					? Math.min(amount + step, target)
					: Math.max(amount - step, target)

			if (!pointer) {
				targetX =
					width * (0.5 + Math.cos(elapsed * DRIFT[0]) * DRIFT_REACH)
				targetY =
					height * (0.5 + Math.sin(elapsed * DRIFT[1]) * DRIFT_REACH)
			}

			lensX += (targetX - lensX) * EASE
			lensY += (targetY - lensY) * EASE

			paint()
			request = requestAnimationFrame(frame)
		}

		function start() {
			if (running) {
				return
			}

			running = true
			last = performance.now()
			request = requestAnimationFrame(frame)
		}

		function stop() {
			running = false
			cancelAnimationFrame(request)
		}

		function resize() {
			width = box.clientWidth
			height = box.clientHeight
			camera.right = width
			camera.bottom = height
			camera.updateProjectionMatrix()
			/* The ratio can change under the window, not only the size */
			renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2))
			renderer.setSize(width, height)
			markUniforms.uSize.value = 3 * renderer.getPixelRatio()
			draw()
			paint()
		}

		box.addEventListener('pointermove', (event) => {
			const bounds = box.getBoundingClientRect()
			pointer = true
			targetX = event.clientX - bounds.left
			targetY = event.clientY - bounds.top
		})

		/* The lens goes back to wandering rather than sticking where the hand left */
		box.addEventListener('pointerleave', () => {
			pointer = false
		})

		window.addEventListener('resize', resize)
		window.addEventListener('zj:theme', () => {
			target = window.__zjTheme === 'dark' ? 1 : 0
		})

		renderer.setSize(width, height)
		markUniforms.uSize.value = 3 * renderer.getPixelRatio()
		draw()
		paint()
		box.appendChild(renderer.domElement)

		return {start, stop}
	}

	const box = document.querySelector<HTMLElement>('[data-lab="a"]')

	if (box) {
		let api: {start(): void; stop(): void} | null = null
		let started = false
		let showing = false

		const settle = () => {
			if (!api) {
				return
			}

			if (showing && document.visibilityState === 'visible') {
				api.start()
			} else {
				api.stop()
			}
		}

		const observer = new IntersectionObserver(
			(entries) => {
				showing = entries[entries.length - 1].isIntersecting

				/* Nothing is fetched until the card is actually on screen */
				if (showing && !started) {
					started = true

					if (hasWebGL()) {
						enhance(box)
							.then((live) => {
								api = live
								settle()
							})
							/* A refused chunk leaves the plain ground, which is no loss */
							.catch(() => undefined)
					}
				}

				settle()
			},
			{threshold: 0.25},
		)

		observer.observe(box)
		document.addEventListener('visibilitychange', settle)
	}
</script>
