<div class="lab-demo" data-lab="h" data-ground="follow">
	<p class="lab-caption">drag a bead</p>
</div>

<style>
	.lab-demo {
		position: relative;
		width: 100%;
		aspect-ratio: 3 / 2;
		overflow: hidden;
		border-radius: 2px;
		background: var(--zj-ground);
		cursor: grab;
		touch-action: none;
	}

	.lab-demo[data-held] {
		cursor: grabbing;
	}

	.lab-demo :global(canvas) {
		position: absolute;
		inset: 0;
		display: block;
	}

	.lab-caption {
		position: absolute;
		left: 0.7rem;
		bottom: 0.55rem;
		margin: 0;
		font-family: var(--z-font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.05em;
		color: var(--zj-text-muted);
		pointer-events: none;
	}
</style>

<script>
	const BEADS = 19
	/* Two markers divide the strand in three, the way a misbaha is counted */
	const MARKERS = [6, 13]
	/* Substeps a second: fine enough that a flicked strand never overshoots a link */
	const TICK = 1 / 180
	const MAX_STEPS = 5
	/*
	 * Passes of Gauss-Seidel over the links each substep. The count is what
	 * tension costs: at ten the top link stretches five per cent under the weight
	 * of everything below it and the strand reads as rubber; at this many it is
	 * two, which is invisible.
	 */
	const RELAX = 24
	/*
	 * Per substep, so about e^-1.3 a second: four or five visible swings and then
	 * stillness, which is what a cord's own friction does to a strand of beads.
	 */
	const DRAG = 0.993
	/*
	 * The strand stands for roughly 30cm of a real one, which is what fixes the
	 * scale: pixels per metre gives gravity in pixels, so the swing keeps its
	 * true period — a little over a second — at any size the card is drawn at.
	 */
	const STRAND_METRES = 0.3
	const GRAVITY = 9.81 / STRAND_METRES
	/* How near a bead a pointer has to come to take hold of it */
	const REACH = 26
	/* A pointer that jumps further than this in one frame is a scroll, not a drag */
	const MAX_STEP = 44
	/* Below this, over this many frames, the strand is at rest and stops drawing */
	const STILL = 0.045
	const PATIENCE = 40

	interface Handle {
		resume(): void
		pause(): void
	}

	interface Point {
		x: number
		y: number
		px: number
		py: number
		pinned: boolean
	}

	interface Link {
		a: number
		b: number
		rest: number
	}

	/* Asked before three.js is fetched, so a machine without WebGL downloads nothing */
	function hasWebGL(): boolean {
		try {
			const probe = document.createElement('canvas')
			const context = probe.getContext('webgl2') ?? probe.getContext('webgl')
			/* Hand the context back rather than sitting on one of the browser's few */
			context?.getExtension('WEBGL_lose_context')?.loseContext()
			return Boolean(context)
		} catch {
			return false
		}
	}

	async function enhance(box: HTMLElement): Promise<Handle> {
		const {
			BufferGeometry,
			Float32BufferAttribute,
			Group,
			LineBasicMaterial,
			LineLoop,
			LineSegments,
			OrthographicCamera,
			Scene,
			WebGLRenderer,
		} = await import('three')

		const renderer = new WebGLRenderer({alpha: true, antialias: true})
		renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2))
		renderer.domElement.setAttribute('aria-hidden', 'true')

		const scene = new Scene()
		/* Pixel space with y running down: gravity is simply +y */
		const camera = new OrthographicCamera(0, 1, 0, 1, -1, 1)
		const strand = new Group()
		scene.add(strand)

		const beadInk = new LineBasicMaterial({transparent: true, opacity: 0.9})
		const cordInk = new LineBasicMaterial({transparent: true, opacity: 0.55})

		/* Beads take the geometry ink, the cord the gilding — both follow the ground */
		function paint() {
			const styles = getComputedStyle(box)
			beadInk.color.set(styles.getPropertyValue('--zj-geo').trim() || '#1d3a6e')
			cordInk.color.set(styles.getPropertyValue('--zj-gild').trim() || '#a97c14')
		}

		paint()

		const circle: number[] = []

		for (let i = 0; i < 28; i++) {
			const t = (i / 28) * Math.PI * 2
			circle.push(Math.cos(t), Math.sin(t), 0)
		}

		const circleGeometry = new BufferGeometry()
		circleGeometry.setAttribute('position', new Float32BufferAttribute(circle, 3))

		const rings = Array.from({length: BEADS + 2}, () => {
			const mesh = new LineLoop(circleGeometry, beadInk)
			strand.add(mesh)
			return mesh
		})

		/*
		 * Point 0 is the hook. Points 1…19 are the beads, 20 the knot under the
		 * last of them, and 21…26 the three short falls of the tassel — all one
		 * chain of links, so the tassel swings off the strand rather than being
		 * drawn onto it.
		 */
		const KNOT = BEADS + 1
		const points: Point[] = []
		const links: Link[] = []
		/* Which links are cord rather than the spreaders holding the tassel open */
		const cords: Link[] = []

		for (let i = 0; i < KNOT + 7; i++) {
			points.push({x: 0, y: 0, px: 0, py: 0, pinned: i === 0})
		}

		const cord = new Float32BufferAttribute(
			new Float32Array((BEADS + 7) * 2 * 3),
			3,
		)
		const cordGeometry = new BufferGeometry()
		cordGeometry.setAttribute('position', cord)
		strand.add(new LineSegments(cordGeometry, cordInk))

		let spacing = 0
		let radius = 0
		let anchorX = 0
		let anchorY = 0
		let gravity = 0

		/* Every rest length is a multiple of the bead spacing, so one number sizes it */
		function measure(width: number, height: number) {
			const next = (height * 0.74) / (BEADS + 2)
			const scale = spacing === 0 ? 0 : next / spacing
			spacing = next
			radius = spacing * 0.4
			anchorX = width / 2
			anchorY = height * 0.08
			gravity = GRAVITY * spacing * (BEADS + 2)

			links.length = 0
			cords.length = 0

			for (let i = 0; i < BEADS; i++) {
				/* A marker bead is fatter, so the cord either side of it runs longer */
				const fat = MARKERS.includes(i) || MARKERS.includes(i + 1)
				links.push({a: i, b: i + 1, rest: spacing * (fat ? 1.2 : 1)})
			}

			links.push({a: BEADS, b: KNOT, rest: radius * 2.2})

			for (let s = 0; s < 3; s++) {
				const head = KNOT + 1 + s * 2
				links.push({a: KNOT, b: head, rest: spacing * 0.45})
				links.push({a: head, b: head + 1, rest: spacing * 0.45})
			}

			cords.push(...links)

			/* Rods between the falls, which is what holds a tassel open */
			for (let s = 0; s < 2; s++) {
				links.push({
					a: KNOT + 2 + s * 2,
					b: KNOT + 4 + s * 2,
					rest: spacing * 0.5,
				})
			}

			/* A resize is not a shove: the pose is carried over at the new scale */
			for (const point of points) {
				if (scale === 0) {
					continue
				}

				point.x = anchorX + (point.x - anchorX) * scale
				point.y = anchorY + (point.y - anchorY) * scale
				point.px = anchorX + (point.px - anchorX) * scale
				point.py = anchorY + (point.py - anchorY) * scale
			}

			points[0].x = anchorX
			points[0].y = anchorY
			points[0].px = anchorX
			points[0].py = anchorY

			for (let i = 0; i < rings.length; i++) {
				rings[i].scale.setScalar(trim(i))
			}
		}

		/* How far from a point's centre its cord starts: the hook, a bead, the knot */
		function trim(index: number): number {
			if (index === 0) {
				return radius * 0.55
			}

			if (index === KNOT) {
				return radius * 0.7
			}

			if (index > KNOT) {
				return 0
			}

			return MARKERS.includes(index) ? radius * 1.35 : radius
		}

		function put(index: number, x: number, y: number) {
			const point = points[index]
			point.x = x
			point.y = y
			point.px = x
			point.py = y
		}

		/* The strand arrives swung aside and falls into place, so it introduces itself */
		function hang(lean: number) {
			const ux = Math.sin(lean)
			const uy = Math.cos(lean)

			for (let i = 1; i <= KNOT; i++) {
				put(i, anchorX + ux * spacing * i, anchorY + uy * spacing * i)
			}

			const knot = points[KNOT]

			for (let s = 0; s < 3; s++) {
				const head = KNOT + 1 + s * 2
				const fan = (s - 1) * spacing * 0.3
				put(
					head,
					knot.x + ux * spacing * 0.45 + fan,
					knot.y + uy * spacing * 0.45,
				)
				put(
					head + 1,
					knot.x + ux * spacing * 0.9 + fan * 2,
					knot.y + uy * spacing * 0.9,
				)
			}
		}

		let held = -1
		let pointer = -1
		let fromX = 0
		let fromY = 0
		let toX = 0
		let toY = 0
		let carry = 0
		let asleep = 0
		let last = 0
		let request = 0
		let running = false
		let awake = false

		function step(dt: number, blend: number) {
			for (let i = 0; i < points.length; i++) {
				const point = points[i]

				/* The hook does not move, and the held bead answers to the hand */
				if (point.pinned || i === held) {
					continue
				}

				const vx = (point.x - point.px) * DRAG
				const vy = (point.y - point.py) * DRAG
				point.px = point.x
				point.py = point.y
				point.x += vx
				point.y += vy + gravity * dt * dt
			}

			if (held >= 0) {
				/*
				 * The pointer is walked across the substeps rather than snapped
				 * to, so the bead leaves the hand with the speed the hand had.
				 */
				const point = points[held]
				point.px = point.x
				point.py = point.y
				point.x = fromX + (toX - fromX) * blend
				point.y = fromY + (toY - fromY) * blend
			}

			for (let pass = 0; pass < RELAX; pass++) {
				for (const link of links) {
					const a = points[link.a]
					const b = points[link.b]
					const freeA = a.pinned || link.a === held ? 0 : 1
					const freeB = b.pinned || link.b === held ? 0 : 1
					const share = freeA + freeB

					if (share === 0) {
						continue
					}

					const dx = b.x - a.x
					const dy = b.y - a.y
					const length = Math.hypot(dx, dy) || 1
					const pull = (length - link.rest) / length

					a.x += dx * pull * (freeA / share)
					a.y += dy * pull * (freeA / share)
					b.x -= dx * pull * (freeB / share)
					b.y -= dy * pull * (freeB / share)
				}
			}
		}

		function place() {
			for (let i = 0; i < rings.length; i++) {
				const point = points[i]
				rings[i].position.set(point.x, point.y, 0)
			}

			cords.forEach((link, i) => {
				const a = points[link.a]
				const b = points[link.b]
				const dx = b.x - a.x
				const dy = b.y - a.y
				const length = Math.hypot(dx, dy) || 1
				/* The cord shows in the gaps and not through the beads it strings */
				const near = trim(link.a)
				const far = trim(link.b)

				cord.setXYZ(
					i * 2,
					a.x + (dx / length) * near,
					a.y + (dy / length) * near,
					0,
				)
				cord.setXYZ(
					i * 2 + 1,
					b.x - (dx / length) * far,
					b.y - (dy / length) * far,
					0,
				)
			})

			cord.needsUpdate = true
		}

		function frame(now: number) {
			/* A backgrounded tab can hand back a huge delta on the first frame */
			const delta = Math.min((now - last) / 1000, 0.1)
			last = now
			/* Capped, so a stalled tab comes back to a strand rather than a spiral */
			carry = Math.min(carry + delta, TICK * MAX_STEPS)
			const steps = Math.floor(carry / TICK)

			for (let s = 0; s < steps; s++) {
				carry -= TICK
				step(TICK, (s + 1) / steps)
			}

			if (held >= 0) {
				fromX = toX
				fromY = toY
			}

			let fastest = 0

			for (const point of points) {
				fastest = Math.max(
					fastest,
					Math.abs(point.x - point.px),
					Math.abs(point.y - point.py),
				)
			}

			place()
			renderer.render(scene, camera)

			/* A strand at rest is a still image; stop drawing it sixty times a second */
			asleep = fastest < STILL && held < 0 ? asleep + 1 : 0

			if (asleep > PATIENCE) {
				awake = false
				return
			}

			request = requestAnimationFrame(frame)
		}

		function wake() {
			asleep = 0

			if (!running || awake) {
				return
			}

			awake = true
			carry = 0
			last = performance.now()
			request = requestAnimationFrame(frame)
		}

		function resize() {
			const width = box.clientWidth
			const height = box.clientHeight

			if (width === 0 || height === 0) {
				return
			}

			camera.right = width
			camera.bottom = height
			camera.updateProjectionMatrix()
			/* The ratio can change under the window, not only the size */
			renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2))
			renderer.setSize(width, height)
			measure(width, height)
			place()
			wake()
		}

		function local(event: PointerEvent): [number, number] {
			const bounds = box.getBoundingClientRect()
			return [event.clientX - bounds.left, event.clientY - bounds.top]
		}

		box.addEventListener('pointerdown', (event) => {
			const [x, y] = local(event)
			let nearest = -1
			let best = REACH

			/* The hook is not a bead, and neither is the tassel: only 1…19 answer */
			for (let i = 1; i <= BEADS; i++) {
				const distance = Math.hypot(points[i].x - x, points[i].y - y)

				if (distance < best) {
					best = distance
					nearest = i
				}
			}

			if (nearest < 0) {
				return
			}

			box.setPointerCapture(event.pointerId)
			box.setAttribute('data-held', '')
			held = nearest
			pointer = event.pointerId
			fromX = points[held].x
			fromY = points[held].y
			toX = x
			toY = y
			wake()
		})

		box.addEventListener('pointermove', (event) => {
			if (held < 0 || event.pointerId !== pointer) {
				return
			}

			const [x, y] = local(event)
			const dx = x - fromX
			const dy = y - fromY
			const jump = Math.hypot(dx, dy)
			const scale = jump > MAX_STEP ? MAX_STEP / jump : 1

			toX = fromX + dx * scale
			toY = fromY + dy * scale
			wake()
		})

		function release(event: PointerEvent) {
			if (held < 0 || event.pointerId !== pointer) {
				return
			}

			held = -1
			box.removeAttribute('data-held')
			wake()
		}

		box.addEventListener('pointerup', release)
		box.addEventListener('pointercancel', release)
		/* A sleeping strand has to be drawn once more to take the new ground's ink */
		window.addEventListener('zj:theme', () => {
			paint()
			wake()
		})

		new ResizeObserver(resize).observe(box)
		resize()
		hang(0.42)
		place()
		box.appendChild(renderer.domElement)

		return {
			resume() {
				running = true
				wake()
			},
			pause() {
				running = false
				awake = false
				cancelAnimationFrame(request)
			},
		}
	}

	function gate(box: HTMLElement) {
		let handle: Handle | null = null
		let pending = false
		let onscreen = false

		function settle() {
			if (!onscreen || document.visibilityState !== 'visible') {
				handle?.pause()
				return
			}

			if (handle) {
				handle.resume()
				return
			}

			if (pending || !hasWebGL()) {
				return
			}

			pending = true
			/* A refused chunk or context leaves the plain ground, which is no loss */
			enhance(box)
				.then((ready) => {
					handle = ready
					settle()
				})
				.catch(() => undefined)
		}

		/* Nothing is fetched, and nothing runs, until the card is actually on screen */
		new IntersectionObserver(
			(entries) => {
				onscreen = entries[entries.length - 1].isIntersecting
				settle()
			},
			{threshold: 0.25},
		).observe(box)

		document.addEventListener('visibilitychange', settle)
	}

	for (const box of document.querySelectorAll<HTMLElement>('[data-lab="h"]')) {
		gate(box)
	}
</script>
