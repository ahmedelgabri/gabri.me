<div class="lab-demo" data-lab="g" data-ground="indigo">
	<div class="lab-controls">
		<p class="lab-readout" data-lab-readout></p>
		<input
			class="lab-slider"
			type="range"
			min="-15"
			max="15"
			step="0.25"
			value="0"
			data-lab-scrub
			aria-label="Days from tonight"
		/>
	</div>
</div>

<style>
	/*
	 * The moon keeps its indigo ground in both page themes, so the inks here are
	 * the dark theme's, pinned rather than taken from the tokens.
	 */
	.lab-demo {
		position: relative;
		width: 100%;
		aspect-ratio: 3 / 2;
		overflow: hidden;
		border-radius: 2px;
		background: #132347;
	}

	.lab-demo :global(canvas) {
		position: absolute;
		inset: 0;
		display: block;
	}

	.lab-controls {
		position: absolute;
		left: 50%;
		bottom: 1.1rem;
		width: min(20rem, 72%);
		transform: translateX(-50%);
	}

	.lab-readout {
		margin: 0 0 0.45rem;
		font-family: var(--z-font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.05em;
		text-align: center;
		color: #a99e85;
	}

	.lab-slider {
		display: block;
		width: 100%;
		height: 0.75rem;
		margin: 0;
		padding: 0;
		background: none;
		cursor: ew-resize;
		-webkit-appearance: none;
		appearance: none;
	}

	.lab-slider::-webkit-slider-runnable-track {
		height: 1px;
		background: rgba(217, 180, 74, 0.4);
	}

	.lab-slider::-moz-range-track {
		height: 1px;
		background: rgba(217, 180, 74, 0.4);
	}

	/* The handle is a diamond: the khatam's four-fold cousin, as on external links */
	.lab-slider::-webkit-slider-thumb {
		width: 9px;
		height: 9px;
		margin-top: -4px;
		border: 1px solid #d9b44a;
		border-radius: 0;
		background: #132347;
		transform: rotate(45deg);
		-webkit-appearance: none;
		appearance: none;
	}

	.lab-slider::-moz-range-thumb {
		width: 9px;
		height: 9px;
		border: 1px solid #d9b44a;
		border-radius: 0;
		background: #132347;
		transform: rotate(45deg);
	}
</style>

<script>
	/* --zj-gild on the indigo ground */
	const GOLD = 0xd9b44a
	const RAD = Math.PI / 180
	const DEGREE = 180 / Math.PI
	const DAY = 86400000
	/* Points along each half of the outline; the fill is the strip between them */
	const ARC = 72
	/* Bright at the limb, all but gone at the terminator, where the sun grazes */
	const LIT = 0.17
	const GRAZED = 0.035
	/* Per second: how fast the terminator catches up with a dragged slider */
	const SCRUB = 9

	interface Handle {
		resume(): void
		pause(): void
	}

	/* Days since J2000.0, the epoch every term below is written against */
	function epochDays(date: Date): number {
		return date.getTime() / DAY - 10957.5
	}

	function wrap(degrees: number): number {
		const turned = degrees % 360
		return turned < 0 ? turned + 360 : turned
	}

	/*
	 * The angle from the sun to the moon as seen from here. Nothing else is
	 * needed: the lit fraction is (1 − cos ψ) / 2, and which limb it hangs from
	 * is whether ψ has passed 180°.
	 *
	 * The phase could be had from a new-moon epoch and a mean synodic month, but
	 * the moon does not keep mean time: that method runs up to fifteen hours
	 * early or late, which is a visibly wrong terminator. These are the leading
	 * terms of the two longitudes instead, checked against five eclipses between
	 * 2017 and 2025, none of which it misses by more than a fifth of a degree.
	 */
	function elongation(days: number): number {
		const sunAnomaly = (357.5291092 + 0.98560028 * days) * RAD
		const moonAnomaly = (134.9633964 + 13.06499295 * days) * RAD
		const mean = (297.8501921 + 12.19074912 * days) * RAD
		const node = (93.272095 + 13.2293502 * days) * RAD
		const moon =
			218.3164477 +
			13.17639648 * days +
			6.289 * Math.sin(moonAnomaly) +
			1.274 * Math.sin(2 * mean - moonAnomaly) +
			0.658 * Math.sin(2 * mean) +
			0.214 * Math.sin(2 * moonAnomaly) -
			0.186 * Math.sin(sunAnomaly) -
			0.114 * Math.sin(2 * node)
		const sun =
			280.4665 +
			0.98564736 * days +
			1.915 * Math.sin(sunAnomaly) +
			0.02 * Math.sin(2 * sunAnomaly)

		return wrap(moon - sun) * RAD
	}

	function name(psi: number): string {
		const degrees = psi * DEGREE
		const waxing = degrees < 180

		if (degrees < 8 || degrees > 352) {
			return 'new moon'
		}

		if (degrees > 172 && degrees < 188) {
			return 'full moon'
		}

		if (degrees > 82 && degrees < 98) {
			return 'first quarter'
		}

		if (degrees > 262 && degrees < 278) {
			return 'last quarter'
		}

		const shape = Math.cos(psi) > 0 ? 'crescent' : 'gibbous'

		return `${waxing ? 'waxing' : 'waning'} ${shape}`
	}

	/* Asked before three.js is fetched, so a machine without WebGL downloads nothing */
	function hasWebGL(): boolean {
		try {
			const probe = document.createElement('canvas')
			const context = probe.getContext('webgl2') ?? probe.getContext('webgl')
			/* Hand the context back rather than sitting on one of the browser's few */
			context?.getExtension('WEBGL_lose_context')?.loseContext()
			return Boolean(context)
		} catch {
			return false
		}
	}

	async function enhance(box: HTMLElement): Promise<Handle> {
		const {
			BufferGeometry,
			Color,
			DoubleSide,
			Float32BufferAttribute,
			Group,
			Line,
			LineBasicMaterial,
			LineLoop,
			Mesh,
			MeshBasicMaterial,
			OrthographicCamera,
			Scene,
			WebGLRenderer,
		} = await import('three')

		const renderer = new WebGLRenderer({alpha: true, antialias: true})
		renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2))
		renderer.domElement.setAttribute('aria-hidden', 'true')

		const scene = new Scene()
		/* Pixel space; the moon is built at radius 1 and scaled to the box */
		const camera = new OrthographicCamera(0, 1, 0, 1, -1, 1)
		const moon = new Group()
		scene.add(moon)

		const gold = new Color(GOLD)
		const readout = box.querySelector<HTMLElement>('[data-lab-readout]')
		const scrub = box.querySelector<HTMLInputElement>('[data-lab-scrub]')

		/* The whole disc, unlit and all: the moon is there on a new moon too */
		const rim: number[] = []

		for (let i = 0; i < 128; i++) {
			const t = (i / 128) * Math.PI * 2
			rim.push(Math.sin(t), -Math.cos(t), 0)
		}

		const rimGeometry = new BufferGeometry()
		rimGeometry.setAttribute('position', new Float32BufferAttribute(rim, 3))
		moon.add(
			new LineLoop(
				rimGeometry,
				new LineBasicMaterial({color: GOLD, transparent: true, opacity: 0.26}),
			),
		)

		/*
		 * Both halves of the lit region share their y, so the limb and the
		 * terminator can be walked together: as an outline down one and back up
		 * the other, and as the strip of quads between them.
		 */
		const edge = new Float32BufferAttribute(new Float32Array((ARC + 1) * 2 * 3), 3)
		const edgeGeometry = new BufferGeometry()
		edgeGeometry.setAttribute('position', edge)
		moon.add(
			new Line(
				edgeGeometry,
				new LineBasicMaterial({color: GOLD, transparent: true, opacity: 0.9}),
			),
		)

		const face = new Float32BufferAttribute(new Float32Array((ARC + 1) * 2 * 3), 3)
		const shade = new Float32BufferAttribute(new Float32Array((ARC + 1) * 2 * 4), 4)
		const indices: number[] = []

		for (let i = 0; i < ARC; i++) {
			const a = i * 2
			indices.push(a, a + 1, a + 2, a + 1, a + 3, a + 2)
			shade.setXYZW(a, gold.r, gold.g, gold.b, LIT)
			shade.setXYZW(a + 1, gold.r, gold.g, gold.b, GRAZED)
		}

		shade.setXYZW(ARC * 2, gold.r, gold.g, gold.b, LIT)
		shade.setXYZW(ARC * 2 + 1, gold.r, gold.g, gold.b, GRAZED)

		const faceGeometry = new BufferGeometry()
		faceGeometry.setAttribute('position', face)
		faceGeometry.setAttribute('color', shade)
		faceGeometry.setIndex(indices)
		moon.add(
			new Mesh(
				faceGeometry,
				/* The strip turns itself inside out at every quarter; draw both faces */
				new MeshBasicMaterial({
					vertexColors: true,
					transparent: true,
					side: DoubleSide,
				}),
			),
		)

		function shape(psi: number) {
			const waist = Math.cos(psi)
			/* North of the equator a waxing moon is lit on the right */
			const side = psi < Math.PI ? 1 : -1

			for (let i = 0; i <= ARC; i++) {
				const t = (i / ARC) * Math.PI
				const across = Math.sin(t)
				const y = -Math.cos(t)
				const limb = side * across
				const terminator = side * waist * across

				face.setXYZ(i * 2, limb, y, 0)
				face.setXYZ(i * 2 + 1, terminator, y, 0)
				/* Down the limb, then back up the terminator: one closed outline */
				edge.setXYZ(i, limb, y, 0)
				edge.setXYZ((ARC + 1) * 2 - 1 - i, terminator, y, 0)
			}

			face.needsUpdate = true
			edge.needsUpdate = true
		}

		let shown = elongation(epochDays(new Date()))
		let target = shown
		let stamp = ''
		let last = 0
		let request = 0
		let running = false
		let awake = false

		function tell(date: Date, psi: number) {
			const lit = Math.round(((1 - Math.cos(psi)) / 2) * 100)
			const line = `${date.toLocaleDateString('en-GB', {
				day: 'numeric',
				month: 'short',
				year: 'numeric',
			})} · ${name(psi)} · ${lit}% lit`

			/* A quarter-day step often reads the same; leave the DOM alone if so */
			if (readout && line !== stamp) {
				stamp = line
				readout.textContent = line
			}
		}

		function aim() {
			const offset = scrub ? Number(scrub.value) : 0
			const date = new Date(Date.now() + offset * DAY)
			target = elongation(epochDays(date))
			tell(date, target)
			wake()
		}

		function frame(now: number) {
			/* A backgrounded tab can hand back a huge delta on the first frame */
			const delta = Math.min((now - last) / 1000, 0.1)
			last = now

			/* The short way round, so scrubbing past a new moon does not unwind a month */
			let step = target - shown

			while (step > Math.PI) {
				step -= Math.PI * 2
			}

			while (step < -Math.PI) {
				step += Math.PI * 2
			}

			shown += step * (1 - Math.exp(-SCRUB * delta))
			/* Held inside one lunation, so the crescent knows which limb it hangs from */
			shown = ((shown % (Math.PI * 2)) + Math.PI * 2) % (Math.PI * 2)
			shape(shown)
			renderer.render(scene, camera)

			/* A settled moon is a still image: stop drawing it sixty times a second */
			if (Math.abs(step) < 0.0004) {
				shown = target
				awake = false
				return
			}

			request = requestAnimationFrame(frame)
		}

		function wake() {
			if (!running || awake) {
				return
			}

			awake = true
			last = performance.now()
			request = requestAnimationFrame(frame)
		}

		function resize() {
			const width = box.clientWidth
			const height = box.clientHeight

			if (width === 0 || height === 0) {
				return
			}

			camera.right = width
			camera.bottom = height
			camera.updateProjectionMatrix()
			/* The ratio can change under the window, not only the size */
			renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2))
			renderer.setSize(width, height)
			/* Above centre: the slider and its reading hang under the moon */
			moon.position.set(width / 2, height * 0.4, 0)
			moon.scale.setScalar(Math.min(width, height) * 0.17)
			wake()
		}

		scrub?.addEventListener('input', aim)
		new ResizeObserver(resize).observe(box)
		resize()
		aim()
		shape(shown)
		box.appendChild(renderer.domElement)

		return {
			resume() {
				running = true
				/* The buffer may have been dropped while the card was away */
				wake()
			},
			pause() {
				running = false
				awake = false
				cancelAnimationFrame(request)
			},
		}
	}

	function gate(box: HTMLElement) {
		let handle: Handle | null = null
		let pending = false
		let onscreen = false

		function settle() {
			if (!onscreen || document.visibilityState !== 'visible') {
				handle?.pause()
				return
			}

			if (handle) {
				handle.resume()
				return
			}

			if (pending || !hasWebGL()) {
				return
			}

			pending = true
			/* A refused chunk or context leaves the plain indigo box, which is no loss */
			enhance(box)
				.then((ready) => {
					handle = ready
					settle()
				})
				.catch(() => undefined)
		}

		/* Nothing is fetched, and nothing runs, until the card is actually on screen */
		new IntersectionObserver(
			(entries) => {
				onscreen = entries[entries.length - 1].isIntersecting
				settle()
			},
			{threshold: 0.25},
		).observe(box)

		document.addEventListener('visibilitychange', settle)
	}

	for (const box of document.querySelectorAll<HTMLElement>('[data-lab="g"]')) {
		gate(box)
	}
</script>
