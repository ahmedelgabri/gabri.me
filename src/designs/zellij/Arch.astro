---
import {arches, ARCH_HEIGHT, ARCH_WIDTH, IMPOST_Y} from './arches'

/*
 * All six arches are rendered; the script below chooses one before they are
 * parsed, and CSS shows only that one. With no script the drop arch — the
 * design's own, from Ibn Tulun — stands.
 */
const viewBox = `0 0 ${ARCH_WIDTH} ${ARCH_HEIGHT}`
const ids = arches.map(({id}) => id)
---

<span class="zj-arch-frame">
	<script is:inline define:vars={{ids}}>
		/*
		 * Runs where it stands, before the arches after it are parsed, so the one
		 * that is drawn is the only one that ever paints: no swap, no restart of
		 * the draw-in, nothing to reflow.
		 */
		;(function () {
			var frame = document.currentScript.parentNode
			frame.setAttribute(
				'data-zj-arch',
				ids[Math.floor(Math.random() * ids.length)],
			)
		})()
	</script>
	{
		arches.map((arch) => (
			<span class="zj-arch-item" data-arch={arch.id}>
				<svg class="zj-arch" viewBox={viewBox} aria-hidden="true">
					<line
						class="zj-arch-impost"
						x1="0"
						y1={IMPOST_Y}
						x2={arch.paths.impostX}
						y2={IMPOST_Y}
						pathLength="1"
					/>
					<line
						class="zj-arch-impost"
						x1={ARCH_WIDTH - arch.paths.impostX}
						y1={IMPOST_Y}
						x2={ARCH_WIDTH}
						y2={IMPOST_Y}
						pathLength="1"
					/>
					<path class="zj-arch-inner" d={arch.paths.inner} pathLength="1" />
					<path class="zj-arch-outer" d={arch.paths.outer} pathLength="1" />
				</svg>
				<span class="zj-arch-caption">
					{arch.caption.pre}<a
						href={arch.caption.href}
						target="_blank"
						rel="noreferrer noopener"
					>{arch.caption.linkText}</a>{arch.caption.post}
				</span>
			</span>
		))
	}
</span>

<style is:global>
	.design-zellij .zj-arch-frame {
		display: block;
	}

	/* All six are in the page; the chosen one is the only one drawn */
	.design-zellij .zj-arch-frame > .zj-arch-item {
		display: none;
	}

	/* Nothing chose — no script — and the drop arch stands */
	.design-zellij .zj-arch-frame:not([data-zj-arch]) > [data-arch='drop'],
	.design-zellij [data-zj-arch='drop'] > [data-arch='drop'],
	.design-zellij [data-zj-arch='horseshoe'] > [data-arch='horseshoe'],
	.design-zellij [data-zj-arch='fourCentred'] > [data-arch='fourCentred'],
	.design-zellij [data-zj-arch='ogee'] > [data-arch='ogee'],
	.design-zellij [data-zj-arch='keel'] > [data-arch='keel'],
	.design-zellij [data-zj-arch='multifoil'] > [data-arch='multifoil'] {
		display: block;
	}

	/* A plate label, shown only while the reader is with the arch. Its line
	 * stays reserved so the reveal never shifts the header. */
	.design-zellij .zj-arch-caption {
		display: block;
		margin-top: 0.15rem;
		font-family: var(--z-font-body);
		font-size: 0.5625rem;
		letter-spacing: 0.04em;
		text-align: center;
		color: var(--zj-text-muted);
		opacity: 0;
		transition: opacity 250ms ease;
	}

	.design-zellij .zj-arch-frame:hover .zj-arch-caption,
	.design-zellij .zj-arch-frame:focus-within .zj-arch-caption {
		opacity: 1;
	}

	/* No hover, no reveal — touch readers keep the label */
	@media (hover: none) {
		.design-zellij .zj-arch-caption {
			opacity: 1;
		}
	}

	.design-zellij .zj-arch-caption a {
		color: inherit;
	}
</style>
