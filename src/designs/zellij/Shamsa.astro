---
import Star from './Star.astro'
---

<div class="zj-shamsa" data-zj-shamsa>
	<Star class="zj-shamsa-static" size={176} />
</div>

<style is:global>
	/* ————— Hero shamsa ————— */

	/* Fixed box: the canvas takes the star's place without moving the masthead */
	.design-zellij .zj-shamsa {
		display: none;
		position: relative;
		width: 220px;
		height: 220px;
		margin: 0 auto 0.6rem;
		color: var(--zj-gild);
		transition: color 300ms ease;
	}

	/* The medallion needs margin around the page to read as illumination */
	@media (min-width: 64em) {
		.design-zellij .zj-shamsa {
			display: grid;
			place-items: center;
		}
	}

	.design-zellij .zj-shamsa canvas {
		position: absolute;
		inset: 0;
		display: block;
	}

	.design-zellij .zj-shamsa-live .zj-shamsa-static {
		display: none;
	}
</style>

<script>
	/* Gilding, matched to --zj-gild in both themes */
	const GOLD = {light: 0xc29228, dark: 0xd9b44a}
	/* The khatam's inner vertices sit where the two squares cross — see geometry.ts */
	const INNER_RATIO = Math.sqrt(2 - Math.SQRT2)
	const RADIUS = 0.86
	const TURN = (Math.PI * 2) / 60
	/* Just under 10° at the edge of the viewport — a nod, not a toy */
	const TILT = 0.17
	/* A standing tilt, so the construction has depth before the pointer arrives */
	const REST = 0.12
	const EASE = 0.06

	function circle(radius: number, segments: number): number[] {
		const values: number[] = []

		for (let i = 0; i < segments; i++) {
			const angle = (i / segments) * Math.PI * 2
			values.push(Math.cos(angle) * radius, Math.sin(angle) * radius, 0)
		}

		return values
	}

	function square(radius: number, offset: number): number[] {
		const values: number[] = []

		for (let k = 0; k < 4; k++) {
			const angle = offset + (k * Math.PI) / 2
			values.push(Math.cos(angle) * radius, Math.sin(angle) * radius, 0)
		}

		return values
	}

	function khatam(radius: number): number[] {
		const values: number[] = []

		for (let k = 0; k < 16; k++) {
			const angle = (k * Math.PI) / 8
			const r = k % 2 === 0 ? radius : radius * INNER_RATIO
			values.push(Math.cos(angle) * r, Math.sin(angle) * r, 0)
		}

		return values
	}

	/* Eight short ties running from the star's points out to the rim */
	function ties(inner: number, outer: number): number[] {
		const values: number[] = []

		for (let k = 0; k < 8; k++) {
			const angle = (k * Math.PI) / 4
			const cos = Math.cos(angle)
			const sin = Math.sin(angle)
			values.push(cos * inner, sin * inner, 0, cos * outer, sin * outer, 0)
		}

		return values
	}

	/* Asked before three.js is fetched, so a machine without WebGL downloads nothing */
	function hasWebGL(): boolean {
		try {
			const probe = document.createElement('canvas')
			const context =
				probe.getContext('webgl2') ?? probe.getContext('webgl')
			/* Hand the context back rather than sitting on one of the browser's few */
			context?.getExtension('WEBGL_lose_context')?.loseContext()
			return Boolean(context)
		} catch {
			return false
		}
	}

	async function enhance(box: HTMLElement) {
		const {
			BufferGeometry,
			Float32BufferAttribute,
			Group,
			LineBasicMaterial,
			LineLoop,
			LineSegments,
			PerspectiveCamera,
			Scene,
			WebGLRenderer,
		} = await import('three')

		const renderer = new WebGLRenderer({alpha: true, antialias: true})
		const size = box.clientWidth
		renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2))
		renderer.setSize(size, size)
		renderer.domElement.setAttribute('aria-hidden', 'true')

		const scene = new Scene()
		const camera = new PerspectiveCamera(38, 1, 0.1, 100)
		camera.position.z = 3.8

		/* Line width is 1px on every platform, which is exactly the hairline wanted */
		const solid = new LineBasicMaterial({transparent: true, opacity: 0.95})
		const faint = new LineBasicMaterial({transparent: true, opacity: 0.5})

		function geometry(values: number[]) {
			const buffer = new BufferGeometry()
			buffer.setAttribute('position', new Float32BufferAttribute(values, 3))
			return buffer
		}

		const squareA = new LineLoop(geometry(square(RADIUS, Math.PI / 4)), solid)
		const squareB = new LineLoop(geometry(square(RADIUS, 0)), solid)
		/* Pulled out of plane in opposite directions so the turn reads as depth */
		squareA.position.z = 0.08
		squareB.position.z = -0.08

		const star = new LineLoop(geometry(khatam(RADIUS)), solid)
		const rosette = new LineLoop(geometry(khatam(0.3)), faint)
		const rimOuter = new LineLoop(geometry(circle(1, 96)), faint)
		const rimInner = new LineLoop(geometry(circle(0.93, 96)), faint)
		const spokes = new LineSegments(geometry(ties(RADIUS, 0.93)), faint)

		/* Tilt answers the pointer, spin runs on its own — one must not cancel the other */
		const tilt = new Group()
		const spin = new Group()
		spin.add(squareA, squareB, star, rosette, rimOuter, rimInner, spokes)
		tilt.add(spin)
		scene.add(tilt)

		function paint() {
			const gold = window.__zjTheme === 'dark' ? GOLD.dark : GOLD.light
			solid.color.setHex(gold)
			faint.color.setHex(gold)
			/* The medallion may be paused, so the new gold has to be drawn here */
			renderer.render(scene, camera)
		}

		let targetX = 0
		let targetY = 0
		let currentX = 0
		let currentY = 0
		let last = 0
		let request = 0
		let running = false

		function frame(now: number) {
			/* A backgrounded tab can hand back a huge delta on the first frame */
			const delta = Math.min((now - last) / 1000, 0.1)
			last = now

			/* In its own plane: a turn about any other axis would go edge-on and vanish */
			spin.rotation.z += TURN * delta
			currentX += (targetX - currentX) * EASE
			currentY += (targetY - currentY) * EASE
			tilt.rotation.x = REST + currentX
			tilt.rotation.y = currentY

			renderer.render(scene, camera)
			request = requestAnimationFrame(frame)
		}

		function start() {
			if (running) {
				return
			}

			running = true
			last = performance.now()
			request = requestAnimationFrame(frame)
		}

		function stop() {
			running = false
			cancelAnimationFrame(request)
		}

		let onScreen = false

		function settle() {
			if (onScreen && document.visibilityState === 'visible') {
				start()
			} else {
				stop()
			}
		}

		window.addEventListener('pointermove', (event) => {
			targetY = (event.clientX / window.innerWidth - 0.5) * 2 * TILT
			targetX = (event.clientY / window.innerHeight - 0.5) * 2 * TILT
		})

		window.addEventListener('zj:theme', paint)
		document.addEventListener('visibilitychange', settle)

		new IntersectionObserver((entries) => {
			onScreen = entries[0].isIntersecting
			settle()
		}).observe(box)

		box.appendChild(renderer.domElement)
		box.classList.add('zj-shamsa-live')
		paint()
	}

	const box = document.querySelector<HTMLElement>('[data-zj-shamsa]')

	if (box) {
		/* Below this the masthead has no margin to spare for a medallion */
		const wide = window.matchMedia('(min-width: 64em)')
		let started = false

		const open = () => {
			if (started || !wide.matches || !hasWebGL()) {
				return
			}

			started = true
			/* A refused chunk or context leaves the static star, which is ornament enough */
			enhance(box).catch(() => undefined)
		}

		open()
		wide.addEventListener('change', open)
	}
</script>
