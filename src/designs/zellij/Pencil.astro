<div class="zj-pencil-layer" data-zj-pencil></div>

<style is:global>
	/* ————— The draughtsman's lens over the background lattice ————— */

	/*
	 * The same layer, the same tile and the same mask as the CSS lattice in
	 * Layout.astro — drawn on a canvas so the construction under the pattern
	 * can be uncovered where the pointer goes. It only ever replaces the CSS
	 * lattice, never joins it: see the .zj-pencil rules below.
	 */
	.design-zellij .zj-pencil-layer {
		display: none;
		position: fixed;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		opacity: 0;
		transition: opacity 400ms ease;
		/* Dies away before the reading column, exactly as body::before does */
		-webkit-mask-image: linear-gradient(
			to right,
			#000 0,
			#000 calc(50% - 31rem),
			transparent calc(50% - 25rem),
			transparent calc(50% + 25rem),
			#000 calc(50% + 31rem),
			#000 100%
		);
		mask-image: linear-gradient(
			to right,
			#000 0,
			#000 calc(50% - 31rem),
			transparent calc(50% - 25rem),
			transparent calc(50% + 25rem),
			#000 calc(50% + 31rem),
			#000 100%
		);
	}

	/* The breakpoint the lattice appears at; below it there is no margin to use */
	@media (min-width: 75em) {
		.design-zellij .zj-pencil-layer {
			display: block;
		}
	}

	.design-zellij .zj-pencil-layer canvas {
		display: block;
	}

	/*
	 * Set on <html> only once the canvas is up and painted, so the CSS lattice
	 * stays the fallback for no-JS, no-WebGL, coarse pointers and narrow
	 * windows. Two classes beat the one in Layout's media query, whatever
	 * order the two style sheets end up in.
	 */
	.design-zellij.zj-pencil .zj-pencil-layer {
		opacity: 1;
	}

	.design-zellij.zj-pencil body::before {
		opacity: 0;
		transition: opacity 400ms ease;
	}
</style>

<script>
	import {INNER_RATIO} from './geometry'
	import {
		FULL_RATE,
		createLayerLifecycle,
		fitPixels,
		hasWebGL,
		loadThree,
		pixelRatio,
	} from './webgl'

	/*
	 * One tile of --zj-screen in Layout.astro, and the centred square lattice
	 * inside it: rosette centres where the two cell indices have the same
	 * parity, the holes that carry the strapwork where they differ. Every
	 * constant below was checked against that tile's own path data — the
	 * canvas has to land on the CSS lattice to the pixel, because for one
	 * cross-fade the reader sees both.
	 */
	const TILE = 240
	const CELL = TILE / 2
	const R = CELL / Math.SQRT2
	/* Where the {16/6} chords cut each other to make the petal valleys */
	const VALLEY =
		(R * Math.cos((6 * Math.PI) / 16)) / Math.cos((5 * Math.PI) / 16)
	/* The circumcircle of the 16-gon the {16/6}'s innermost intersections describe */
	const INNER = (R * Math.cos((6 * Math.PI) / 16)) / Math.cos(Math.PI / 16)
	/* Every one of the sixteen chords is tangent to this circle */
	const APOTHEM = R * Math.cos((6 * Math.PI) / 16)
	/* The free radius left in the lattice's holes */
	const HOLE = CELL - R
	/* The hole's star is {8/3} — sharper than the khatam's two squares */
	const HOLE_INNER = (HOLE * Math.cos((3 * Math.PI) / 8)) / Math.cos(Math.PI / 4)
	/* Half-width of the lozenge strap where it passes the mid-point */
	const STRAP_WAIST = 6
	const POINTS = 16
	/* The {16/6} step: each point is joined to the sixth from it */
	const STEP = 6

	/* The tile's own stroke: kohl by day, gold by night */
	const INK_LIGHT = 0x26221a
	const INK_DARK = 0xd9b44a
	/* --zj-screen-opacity per theme — the whole lattice's weight on the ground */
	const SCREEN = [0.06, 0.08]
	/*
	 * The tile strokes structure at 1 and infill at .55. A GL line has one
	 * width and no other, so the lighter of the two weights is carried as
	 * alpha instead.
	 */
	const INFILL = 0.55
	/* The pattern lifts a little where the lens sits, so the two layers agree */
	const LENS_LIFT = 0.5
	/*
	 * The pencil under the ink: heavier than the line it explains — otherwise
	 * there is nothing to find — and still quiet enough to be a background.
	 */
	const PENCIL = 1.9
	const MARK = 2.4
	const MARK_SIZE = 3

	const LENS = 120
	/* Per second: how quickly the lens closes the gap to wherever it is wanted */
	const FOLLOW = 10
	/* Seconds to cross-fade the ink when the page changes theme */
	const FADE = 0.3
	/* The lens wanders on its own until a pointer takes it over */
	const WANDER = [0.21, 0.29]
	const WANDER_REACH = 0.32
	/* Slow enough to finish a wander in one margin before crossing to the other */
	const WANDER_CROSS = 0.08
	/*
	 * Where the mask above is opaque again, in root ems: the lattice only
	 * shows in the two margins, so that is the only place an unattended lens
	 * has anything to reveal.
	 */
	const MARGIN_REM = 31
	/* And where it is wholly transparent: the reading column, never uncovered */
	const CLEAR_REM = 25

	/*
	 * A full-viewport field of hairlines, carried at whatever alpha keeps the
	 * ink the same at any density. Three device pixels to two CSS ones resolve
	 * them as well as four do and cost little over half the fragments.
	 */
	const MAX_RATIO = 1.5
	/*
	 * An unattended lens crosses its margin at a hundred pixels a second, and
	 * it is a soft 120px mask with a 90px ramp: ten frames a second moves its
	 * edge a ninth of that ramp at a time, which is nothing to look at.
	 */
	const WANDER_FPS = 10
	/*
	 * A parked lens changes nothing on its own — the drift only rides frames
	 * that are already being painted — so the loop keeps a slow heartbeat for
	 * its checks and lets pointer and theme events boost it awake.
	 */
	const PARKED_FPS = 0.5
	/* Seconds of full rate on a pointer, until the lens can answer for itself */
	const CHASE = 0.2
	/* Under half a CSS pixel of lens travel is not a frame anyone would miss */
	const MOVED = 0.5

	/* The lattice crosses one whole tile down its diagonal every 360 seconds */
	const DRIFT_PERIOD = 360
	/*
	 * Cells of overhang before the origin. The drift only ever carries the
	 * lattice down and to the right, so the furthest cell that can still
	 * arrive in the viewport is a whole tile plus the R its figure reaches
	 * past its own centre — (TILE + R) / CELL, or two — before the near edge.
	 * Nothing ever arrives from past the far edge, which is why there is no
	 * overhang on that side at all.
	 */
	const OVERHANG = 2

	/* Set on <html> once the canvas has taken the lattice over from CSS */
	const TAKEOVER = 'zj-pencil'

	type Point = [number, number]

	function ring(
		outer: number,
		inner: number,
		arms: number,
		phase: number,
	): Point[] {
		const points: Point[] = []

		for (let k = 0; k < arms * 2; k++) {
			const angle = phase + (k * Math.PI) / arms
			const radius = k % 2 === 0 ? outer : inner
			points.push([Math.cos(angle) * radius, Math.sin(angle) * radius])
		}

		return points
	}

	function circle(radius: number, steps: number): Point[] {
		return Array.from({length: steps}, (_, k) => {
			const angle = (k * Math.PI * 2) / steps
			return [Math.cos(angle) * radius, Math.sin(angle) * radius] as Point
		})
	}

	function loop(target: number[], points: Point[], cx: number, cy: number) {
		for (let i = 0; i < points.length; i++) {
			const from = points[i]
			const to = points[(i + 1) % points.length]
			target.push(cx + from[0], cy + from[1], 0, cx + to[0], cy + to[1], 0)
		}
	}

	function segment(
		target: number[],
		ax: number,
		ay: number,
		bx: number,
		by: number,
	) {
		target.push(ax, ay, 0, bx, by, 0)
	}

	/* The sixteen points stepped round the generating circle */
	function divisions(): Point[] {
		return Array.from({length: POINTS}, (_, k) => {
			const angle = (k * Math.PI * 2) / POINTS
			return [Math.cos(angle) * R, Math.sin(angle) * R] as Point
		})
	}

	function rosette(
		structure: number[],
		infill: number[],
		cx: number,
		cy: number,
	) {
		/* The ring of sixteen petals: tips at R, valleys where the chords cross */
		loop(structure, ring(R, VALLEY, POINTS, 0), cx, cy)
		/* The khatam inscribed in the innermost figure */
		loop(structure, ring(INNER, INNER * INNER_RATIO, 8, 0), cx, cy)
		/* The nested ring interlocking with the petals, half a step round */
		loop(infill, ring(VALLEY, INNER, POINTS, Math.PI / POINTS), cx, cy)
		loop(infill, circle(INNER, 72), cx, cy)
	}

	function hole(structure: number[], infill: number[], cx: number, cy: number) {
		loop(structure, ring(HOLE, HOLE_INNER, 8, 0), cx, cy)
		loop(infill, circle(HOLE_INNER, 48), cx, cy)

		/*
		 * Each diagonal tip launches a strap onto the tangency point where two
		 * rosettes kiss, waisted so neighbouring straps never chain into one
		 * straight diagonal across the plane.
		 */
		for (let k = 0; k < 4; k++) {
			const angle = Math.PI / 4 + (k * Math.PI) / 2
			const cos = Math.cos(angle)
			const sin = Math.sin(angle)
			const strap = [
				[HOLE, 0],
				[CELL / 2, STRAP_WAIST],
				[R, 0],
				[CELL / 2, -STRAP_WAIST],
			].map(
				([along, across]) =>
					[along * cos - across * sin, along * sin + across * cos] as Point,
			)

			loop(infill, strap, cx, cy)
		}
	}

	/* The marks a compass and straightedge would leave getting to one rosette */
	function construction(
		target: number[],
		marks: number[],
		cx: number,
		cy: number,
	) {
		/* The compass circle the whole figure is stepped round, and its three children */
		loop(target, circle(R, 96), cx, cy)
		loop(target, circle(VALLEY, 96), cx, cy)
		loop(target, circle(INNER, 72), cx, cy)
		loop(target, circle(APOTHEM, 72), cx, cy)

		const points = divisions()

		for (let k = 0; k < POINTS; k++) {
			const from = points[k]
			const to = points[(k + STEP) % POINTS]
			segment(target, cx, cy, cx + from[0], cy + from[1])
			segment(target, cx + from[0], cy + from[1], cx + to[0], cy + to[1])
			marks.push(cx + from[0], cy + from[1], 0)
		}
	}

	function between(pair: number[], amount: number): number {
		return pair[0] + (pair[1] - pair[0]) * amount
	}

	/*
	 * The lattice slides with the drift, so the lens has to be measured against
	 * where each line actually landed rather than where it was built.
	 * Everything else is a distance test in the fragment shader, which is why
	 * nothing here is rebuilt as the lens moves.
	 */
	const LINE_VERTEX = `
		uniform vec2 uShift;

		varying vec2 vPlace;

		void main() {
			vPlace = position.xy + uShift;
			gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
		}
	`

	const LINE_FRAGMENT = `
		uniform vec2 uLens;
		uniform float uRadius;
		uniform vec3 uColor;
		uniform float uBase;
		uniform float uLit;

		varying vec2 vPlace;

		void main() {
			/* Soft all the way out, so the lens never shows a rim */
			float lens = smoothstep(uRadius, uRadius * 0.25, distance(vPlace, uLens));
			float alpha = uBase + uLit * lens;

			/* Most of a full-viewport pencil is nothing at all; skip its blend */
			if (alpha < 0.004) {
				discard;
			}

			gl_FragColor = vec4(uColor, alpha);
			#include <colorspace_fragment>
		}
	`

	const MARK_VERTEX = `
		uniform vec2 uShift;
		uniform float uSize;

		varying vec2 vPlace;

		void main() {
			vPlace = position.xy + uShift;
			gl_PointSize = uSize;
			gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
		}
	`

	const MARK_FRAGMENT = `
		uniform vec2 uLens;
		uniform float uRadius;
		uniform vec3 uColor;
		uniform float uLit;

		varying vec2 vPlace;

		void main() {
			float lens = smoothstep(uRadius, uRadius * 0.25, distance(vPlace, uLens));
			/* A bare point is a square; round the compass prick off */
			float mark = smoothstep(0.5, 0.28, length(gl_PointCoord - vec2(0.5)));
			float alpha = uLit * lens * mark;

			if (alpha < 0.004) {
				discard;
			}

			gl_FragColor = vec4(uColor, alpha);
			#include <colorspace_fragment>
		}
	`

	async function enhance(box: HTMLElement, wide: MediaQueryList) {
		const {
			BufferGeometry,
			Color,
			Float32BufferAttribute,
			Group,
			LineSegments,
			OrthographicCamera,
			Points,
			Scene,
			ShaderMaterial,
			Vector2,
			WebGLRenderer,
		} = await loadThree()

		const renderer = new WebGLRenderer({alpha: true, antialias: true})
		renderer.domElement.setAttribute('aria-hidden', 'true')

		let width = box.clientWidth
		let height = box.clientHeight
		let ratio = pixelRatio(MAX_RATIO)

		const scene = new Scene()
		/* Pixel space with y running down, so every constant above is a CSS pixel */
		const camera = new OrthographicCamera(0, width, 0, height, -1, 1)

		const inkLight = new Color(INK_LIGHT)
		const inkDark = new Color(INK_DARK)
		/* One colour and one lens between all four materials, mutated in place */
		const ink = new Color()
		const lens = new Vector2()
		const shift = new Vector2()
		const shared = {
			uLens: {value: lens},
			uShift: {value: shift},
			uRadius: {value: LENS},
			uColor: {value: ink},
		}

		function lineMaterial() {
			return new ShaderMaterial({
				transparent: true,
				uniforms: {...shared, uBase: {value: 0}, uLit: {value: 0}},
				vertexShader: LINE_VERTEX,
				fragmentShader: LINE_FRAGMENT,
			})
		}

		const structureMaterial = lineMaterial()
		const infillMaterial = lineMaterial()
		const pencilMaterial = lineMaterial()
		const markMaterial = new ShaderMaterial({
			transparent: true,
			uniforms: {...shared, uLit: {value: 0}, uSize: {value: MARK_SIZE}},
			vertexShader: MARK_VERTEX,
			fragmentShader: MARK_FRAGMENT,
		})

		const structureGeometry = new BufferGeometry()
		const infillGeometry = new BufferGeometry()
		const pencilGeometry = new BufferGeometry()
		const markGeometry = new BufferGeometry()

		/* One group, so the whole lattice can be slid by the drift in one move */
		const group = new Group()
		group.add(new LineSegments(structureGeometry, structureMaterial))
		group.add(new LineSegments(infillGeometry, infillMaterial))
		group.add(new LineSegments(pencilGeometry, pencilMaterial))
		group.add(new Points(markGeometry, markMaterial))
		scene.add(group)

		function upload(geometry: typeof structureGeometry, values: number[]) {
			/* The lattice is rebuilt when the window grows; free the old buffers first */
			geometry.dispose()
			geometry.setAttribute('position', new Float32BufferAttribute(values, 3))
		}

		let spanX = 0
		let spanY = 0
		/* Half the width of the reading column the mask leaves wholly clear */
		let clear = 0
		/* The run of columns that column covers, which no drift can uncover */
		let hiddenFrom = 0
		let hiddenTo = -1

		function draw() {
			const columns = Math.floor((width + R) / CELL)
			const rows = Math.floor((height + R) / CELL)
			/*
			 * The reading column is wholly transparent in the mask, so a column
			 * whose figure cannot reach either margin from anywhere in the
			 * drift's cycle is never seen — and the middle of the page is where
			 * the most of them are.
			 */
			const from = Math.ceil((width / 2 - clear + R) / CELL)
			const to = Math.floor((width / 2 + clear - R - TILE) / CELL)

			/*
			 * A window that only got smaller keeps the larger lattice: the
			 * extra overhang costs nothing offscreen, and rebuilding a couple
			 * of hundred thousand vertices mid-drag would be felt. The covered
			 * columns travel with the middle of the window, though, so those
			 * are answered afresh whichever way it went.
			 */
			if (
				columns <= spanX &&
				rows <= spanY &&
				from === hiddenFrom &&
				to === hiddenTo
			) {
				return
			}

			spanX = Math.max(columns, spanX)
			spanY = Math.max(rows, spanY)
			hiddenFrom = from
			hiddenTo = to

			const structure: number[] = []
			const infill: number[] = []
			const pencil: number[] = []
			const marks: number[] = []

			for (let i = -OVERHANG; i <= spanX; i++) {
				if (i >= hiddenFrom && i <= hiddenTo) {
					continue
				}

				for (let j = -OVERHANG; j <= spanY; j++) {
					const cx = i * CELL
					const cy = j * CELL

					/* Matching parities carry a rosette, mixed ones the hole between four */
					if ((i + j) % 2 === 0) {
						rosette(structure, infill, cx, cy)
						construction(pencil, marks, cx, cy)
					} else {
						hole(structure, infill, cx, cy)
					}
				}
			}

			upload(structureGeometry, structure)
			upload(infillGeometry, infill)
			upload(pencilGeometry, pencil)
			upload(markGeometry, marks)
		}

		let lensX = width / 2
		let lensY = height / 2
		let targetX = lensX
		let targetY = lensY
		/* How much lattice the mask leaves standing on either side of the page */
		let band = LENS
		let pointer = false
		let amount = window.__zjTheme === 'dark' ? 1 : 0
		let target = amount
		let elapsed = 0
		let lost = false
		let drift = 0
		/* Where the last painted frame put the lens */
		let shownX = lensX
		let shownY = lensY

		function paint() {
			ink.copy(inkLight).lerp(inkDark, amount)

			/*
			 * A GL line is one device pixel wide whatever the display density,
			 * where the tile's stroke is one CSS pixel. Carrying the shortfall
			 * as alpha keeps the same ink on the page at any ratio.
			 */
			const weight = between(SCREEN, amount)
			const line = weight * ratio

			structureMaterial.uniforms.uBase.value = line
			structureMaterial.uniforms.uLit.value = line * LENS_LIFT
			infillMaterial.uniforms.uBase.value = line * INFILL
			infillMaterial.uniforms.uLit.value = line * INFILL * LENS_LIFT
			pencilMaterial.uniforms.uLit.value = line * PENCIL
			/* The compass marks are points, already sized in device pixels */
			markMaterial.uniforms.uLit.value = weight * MARK

			group.position.set(drift, drift, 0)
			shift.set(drift, drift)
			lens.set(lensX, lensY)

			renderer.render(scene, camera)

			shownX = lensX
			shownY = lensY
		}

		/*
		 * Nothing on this layer moves quickly enough to be worth a frame it did
		 * not earn: a lens that has not crossed half a pixel with no cross-fade
		 * running would draw the very same picture again — and the drift only
		 * ever moves under one of those.
		 */
		function step(delta: number): boolean {
			elapsed += delta

			const was = amount
			const pace = delta / FADE
			amount =
				target > amount
					? Math.min(amount + pace, target)
					: Math.max(amount - pace, target)

			if (!pointer) {
				/*
				 * The mask leaves the lattice showing only in the two margins,
				 * so an unattended lens wanders one of them and crosses to the
				 * other every forty seconds or so.
				 */
				const across =
					band * (0.5 + Math.cos(elapsed * WANDER[0]) * WANDER_REACH)

				targetX = Math.cos(elapsed * WANDER_CROSS) < 0 ? across : width - across
				targetY =
					height * (0.5 + Math.sin(elapsed * WANDER[1]) * WANDER_REACH)
			}

			const close = 1 - Math.exp(-FOLLOW * delta)
			lensX += (targetX - lensX) * close
			lensY += (targetY - lensY) * close

			const earned =
				amount !== was ||
				Math.abs(lensX - shownX) > MOVED ||
				Math.abs(lensY - shownY) > MOVED

			/*
			 * The drift rides frames the fade or the lens already earned, so it
			 * stays sub-pixel smooth and is never the reason a frame exists: a
			 * parked page holds perfectly still instead of ticking a pixel at a
			 * time, and a blurred one resumes where it stopped instead of
			 * snapping to a wall clock.
			 */
			if (earned) {
				drift = (drift + (delta * TILE) / DRIFT_PERIOD) % TILE
			}

			return earned
		}

		/*
		 * A cross-fade and a lens still closing on a pointer both want every
		 * frame the display has. An unattended lens is always on its way
		 * somewhere and wants a tenth of them; one the pointer has parked has
		 * nothing to paint at all.
		 */
		function fps(): number {
			if (amount !== target) {
				return FULL_RATE
			}

			if (!pointer) {
				return WANDER_FPS
			}

			return Math.abs(targetX - lensX) > MOVED ||
				Math.abs(targetY - lensY) > MOVED
				? FULL_RATE
				: PARKED_FPS
		}

		/* Below the lattice's breakpoint the layer is display:none and measures 0 */
		function awake(): boolean {
			return wide.matches && !lost
		}

		const life = createLayerLifecycle({
			step,
			paint,
			awake,
			fps,
			counter: 'pencil',
		})

		/* The one thing the frame loop cannot notice for itself, so it paints here */
		function resize() {
			const next = box.clientWidth
			const tall = box.clientHeight

			if (next === 0 || tall === 0) {
				return
			}

			width = next
			height = tall
			ratio = fitPixels(renderer, camera, width, height, MAX_RATIO)
			markMaterial.uniforms.uSize.value = MARK_SIZE * ratio

			const rem = Number.parseFloat(
				getComputedStyle(document.documentElement).fontSize,
			)
			band = Math.max(width / 2 - MARGIN_REM * rem, LENS)
			clear = CLEAR_REM * rem

			draw()
			paint()
		}

		window.addEventListener('pointermove', (event) => {
			pointer = true
			targetX = event.clientX
			targetY = event.clientY
			/* A parked lens is on a half-second timer and must not answer this late */
			life.boost(CHASE)
		})

		/* Out of the window: the lens wanders again rather than sticking */
		document.documentElement.addEventListener('pointerleave', () => {
			pointer = false
		})

		window.addEventListener('resize', resize)

		wide.addEventListener('change', () => {
			resize()
			life.settle()
		})

		/* The lattice is drawn in both themes, so this only ever re-inks it */
		window.addEventListener('zj:theme', () => {
			target = window.__zjTheme === 'dark' ? 1 : 0
			/* The cross-fade is over in three tenths and cannot wait on a timer */
			life.boost(FADE)
		})

		/*
		 * A lost context would leave the margins blank, so the CSS lattice
		 * takes its own work back and the loop parks.
		 */
		renderer.domElement.addEventListener('webglcontextlost', () => {
			lost = true
			document.documentElement.classList.remove(TAKEOVER)
			life.settle()
		})

		resize()
		box.appendChild(renderer.domElement)
		/* Only now, with something painted, does the CSS lattice stand down */
		document.documentElement.classList.add(TAKEOVER)
		life.settle()
	}

	const box = document.querySelector<HTMLElement>('[data-zj-pencil]')

	if (box) {
		/* The breakpoint the CSS lattice appears at, and nowhere else */
		const wide = window.matchMedia('(min-width: 75em)')
		/* A finger has no hover to follow, so there is no lens to draw for it */
		const fine = window.matchMedia('(hover: hover) and (pointer: fine)')
		let started = false

		const open = () => {
			if (started || !wide.matches || !fine.matches || !hasWebGL()) {
				return
			}

			started = true
			/* A refused chunk or context leaves the CSS lattice, which is its whole job */
			enhance(box, wide).catch(() => undefined)
		}

		open()
		wide.addEventListener('change', open)
		fine.addEventListener('change', open)
	}
</script>
