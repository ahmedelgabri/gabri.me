---
import Layout from '../../designs/zellij/Layout.astro'
import Star from '../../designs/zellij/Star.astro'
import StarDivider from '../../designs/zellij/StarDivider.astro'
import LabAstrolabe from '../../designs/zellij/lab/LabAstrolabe.astro'
import LabConstruction from '../../designs/zellij/lab/LabConstruction.astro'
import LabDuskDawn from '../../designs/zellij/lab/LabDuskDawn.astro'
import LabMashrabiya from '../../designs/zellij/lab/LabMashrabiya.astro'
import LabMisbaha from '../../designs/zellij/lab/LabMisbaha.astro'
import LabMoon from '../../designs/zellij/lab/LabMoon.astro'
import LabNightSky from '../../designs/zellij/lab/LabNightSky.astro'
import LabPencil from '../../designs/zellij/lab/LabPencil.astro'
import LabScribe from '../../designs/zellij/lab/LabScribe.astro'

/*
 * The baseline first, then the ideas that would replace or join it. `ground`
 * is the ground the demo shows itself on, which need not be the page's: every
 * idea is judged where it would actually live.
 */
const candidates = [
	{
		id: 's',
		letter: 'S',
		name: 'Night sky (current), thinned',
		where: 'dark theme · every page',
		ground: 'indigo ground',
		note: 'The incumbent shrunk to a card: thirty-odd stars and a couple of khatams breathing on their own phases, plus the streak that is the whole point of it. The button fires one on demand — on the real page you wait between one and two minutes. It ships today and costs one small module in dark mode only, so everything below has to be worth more than that.',
		Demo: LabNightSky,
	},
	{
		id: 'a',
		letter: 'A',
		name: 'The draftsman’s pencil',
		where: 'both themes · every page',
		ground: 'follows the page',
		note: 'The lattice behind every page is a tiled SVG today. Here it is drawn as line-work instead, and the pointer carries a soft lens that brings back the pencil under the ink: the compass circle, the sixteen points stepped round it, the {16/6} chords, the circle every chord is tangent to, and the circle their innermost crossings describe. The construction is the real one — the same numbers the shipped tile is generated from — so the page quietly explains itself to anyone who moves a cursor over it. Cost: the background stops being a CSS image and becomes a canvas, and it rewards nobody without a pointer.',
		Demo: LabPencil,
	},
	{
		id: 'b',
		letter: 'B',
		name: 'Sun through the mashrabiya',
		where: 'light theme · every page',
		ground: 'ivory ground',
		note: 'The answer to wanting three.js in daylight: one screen, one sun, and pools of warm patterned light creeping across the ivory. The openings are the design’s own khatam and cross tiles, and the rim of each pool is softer than its core — which is what makes it read as light rather than as a pattern stuck to the page. Risk: it is a fragment shader over the whole ground running the entire time you are reading, so it has to stay cheap and stay at the faint tint it is at here. Any stronger and it is wallpaper.',
		Demo: LabMashrabiya,
	},
	{
		id: 'c',
		letter: 'C',
		name: 'The margin scribe',
		where: 'light theme · the margin',
		ground: 'ivory ground',
		note: 'Every fourteen to twenty seconds a reed-pen swash draws itself, holds, and is absorbed into the paper. Three abstract flourishes, mirrored and tilted at random; the weight comes from cutting one curve into separately-weighted pieces that share their tangents, so it still reads as a single pass of the pen. This one is not three.js at all — SVG and the animation API — which makes it the cheapest idea here and the easiest to keep.',
		Demo: LabScribe,
	},
	{
		id: 'd',
		letter: 'D',
		name: 'Dusk and dawn',
		where: 'both themes · the theme toggle',
		ground: 'follows the page',
		note: 'The theme switch as an event rather than a repaint: indigo sweeps the page corner to corner while star-points kindle in the margins behind the front, and dawn brings the light back from the opposite corner. What is in the box is a mockup — the buttons move the miniature, never the page you are reading. It is a CSS mask and one 1.2s loop, so it costs nothing; the question is whether a ceremony that long would wear thin on the fifth toggle.',
		Demo: LabDuskDawn,
	},
	{
		id: 'g',
		letter: 'G',
		name: 'The true moon',
		where: 'dark theme · the toggle glyph, or the sky',
		ground: 'indigo ground',
		note: 'Tonight’s moon, computed from a known new-moon epoch and the synodic month rather than drawn from stock, with the terminator on the right side of it. The slider scrubs a fortnight either way so the whole cycle is visible from one visit. In integration it replaces the static crescent on the theme toggle, or hangs in the night sky — either way it is the one thing on the page that is genuinely different every night.',
		Demo: LabMoon,
	},
	{
		id: 'e',
		letter: 'E',
		name: 'The astrolabe',
		where: 'dark theme · footer showpiece',
		ground: 'indigo ground',
		note: 'A planispheric astrolabe in line-work: mater, degree ring, a couple of almucantars, a rete of pierced star pointers and a rule. It creeps at a sped-up sidereal rate and takes a drag with inertia. The star positions are approximate and it is the heaviest thing on this page, which is exactly why it is proposed for the footer or a colophon — a reward for reaching the bottom rather than a tax on arriving.',
		Demo: LabAstrolabe,
	},
	{
		id: 'f',
		letter: 'F',
		name: 'How this page is drawn',
		where: 'both themes · a dedicated page',
		ground: 'follows the page',
		note: 'The rosette builds itself in five captioned stages on a loop: the generating circle and its sixteen points, the {16/6} chords, the petals falling out of their intersections, the inner ring and khatam, then the finished figure. It is the same construction A hides under the pointer, told once and in order instead of found by accident. Best on a page about the design; on the home page it would compete with the reading.',
		Demo: LabConstruction,
	},
	{
		id: 'h',
		letter: 'H',
		name: 'Misbaha',
		where: 'both themes · the margin',
		ground: 'follows the page',
		note: 'Nineteen beads on a thread, hung from the top of the box and run on verlet physics. Drag one and let go: the strand swings and settles the way a real one does, and whether that motion is right is the entire idea. It costs almost nothing, but it wants a margin wide enough to hang in, and it rewards a reader who plays with it far more than one who scrolls past.',
		Demo: LabMisbaha,
	},
]
---

<Layout
	title="three.js lab"
	description="Candidates for where three.js lives in the Zellij design, compared as live demos."
>
	<section class="zj-section" aria-labelledby="lab">
		<h1 class="zj-section-title" id="lab">three.js lab</h1>
		<p class="zj-lead">
			Somewhere between one shooting star and a page running a physics engine
			there is a right amount of three.js for this design. This page is the
			comparison: nine candidates, each a live demo, each shown on the ground
			it belongs to — a card sitting on ivory in the middle of a dark page
			means the idea is a daylight one.
		</p>
		<p class="zj-lead">
			The baseline comes first: <span class="zl-cite">S</span> is what the design
			ships today, and every card below says where its idea would live if it won
			and what it would cost. Nothing here is integrated; each demo is scoped to
			its own box, starts when it scrolls into view and stops when it leaves, so
			the page is never running nine loops at once. Nine WebGL canvases in one
			document is still more than a browser is glad to hold, so if a card comes
			up blank after a long scroll, reload — no real page here would ever run
			more than one. The losers get deleted, the way three of the four
			typography pairings did.
		</p>
	</section>

	{
		candidates.map(({Demo, ...candidate}) => (
			<>
				<StarDivider />
				<section class="zj-section zl-card" aria-labelledby={`lab-${candidate.id}`}>
					<h2 class="zj-section-title" id={`lab-${candidate.id}`}>
						<span class="zl-letter">{candidate.letter}</span> — {candidate.name}
					</h2>
					<p class="zl-where">
						<span class="zl-mark" aria-hidden="true">
							<Star size={9} />
						</span>
						{candidate.where} · {candidate.ground}
					</p>
					<p class="zl-note">{candidate.note}</p>
					<div class="zl-frame">
						<Demo />
					</div>
				</section>
			</>
		))
	}

	<StarDivider />

	<section class="zj-section" aria-labelledby="choosing">
		<h2 class="zj-section-title" id="choosing">How to choose</h2>
		<p class="zj-lead">
			Name the letters. They are not exclusive: a daylight idea and a night one
			can both win, and a background (<span class="zl-cite">A</span>, <span
				class="zl-cite">B</span>) can sit under a small ornament (<span
				class="zl-cite">C</span>, <span class="zl-cite">G</span>, <span
				class="zl-cite">H</span>) without either noticing. What they cannot all
			share is the reader’s attention — two moving things in the same margin is
			one too many.
		</p>
		<p class="zj-lead">
			If nothing here beats <span class="zl-cite">S</span>, it stays and the rest
			go.
		</p>
	</section>
</Layout>

<style is:global>
	/* ————— three.js lab cards ————— */

	.design-zellij .zl-card > .zj-section-title {
		margin-bottom: 0.45rem;
	}

	.design-zellij .zl-letter {
		font-family: var(--z-font-mono);
		font-size: 0.62em;
		letter-spacing: 0.1em;
		color: var(--zj-gild);
	}

	/* The same letter cited in running text stays text: gilding is ornament only */
	.design-zellij .zl-cite {
		font-family: var(--z-font-mono);
		font-size: 0.85em;
		letter-spacing: 0.06em;
	}

	.design-zellij .zl-where {
		margin: 0;
		text-align: center;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--zj-text-muted);
	}

	/* The list marker of the design, doing duty as the card's rubric mark */
	.design-zellij .zl-mark {
		display: inline-block;
		margin-right: 0.55rem;
		vertical-align: -0.05em;
		color: var(--zj-gild);
	}

	.design-zellij .zl-note {
		margin: 1rem 0 1.3rem;
	}

	/* The card supplies the chrome; every demo box is flush inside it */
	.design-zellij .zl-frame {
		overflow: hidden;
		border: 1px solid var(--zj-panel-edge);
		border-radius: 2px;
		transition: border-color 300ms ease;
	}
</style>
