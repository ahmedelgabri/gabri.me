---
import {render} from 'astro:content'
import {compareDesc, format} from 'date-fns'
import {
	getAllWeeklyLinks,
	getWeeklyLinksEntry,
	getWeeklyLinksStaticPaths,
	generateExcerpt,
} from '../../../lib/content'
import Layout from '../../../designs/zellij/Layout.astro'
import Arch from '../../../designs/zellij/Arch.astro'
import StarDivider from '../../../designs/zellij/StarDivider.astro'
import ProseLink from '../../../designs/zellij/ProseLink.astro'
import YouTube from '../../../components/YouTube'

export const getStaticPaths = getWeeklyLinksStaticPaths

const {slug} = Astro.params
const entry = await getWeeklyLinksEntry(slug!)

if (!entry || !entry.data.published) {
	return Astro.redirect('/404')
}

const {title, date, tags} = entry.data
const excerpt = entry.data.excerpt || generateExcerpt(entry.body)
const formattedDate = format(date, 'yyyy-MM-dd')

const posts = (await getAllWeeklyLinks()).sort(({date: a}, {date: b}) =>
	compareDesc(new Date(a), new Date(b)),
)
const index = posts.findIndex((post) => post.slug === slug)
const newer = index > 0 ? posts[index - 1] : null
const older =
	index >= 0 && index < posts.length - 1 ? posts[index + 1] : null

const {Content} = await render(entry)
---

<Layout title={title} description={excerpt}>
	<article class="zj-article">
		<header class="zj-article-header">
			<Arch />
			<p class="zj-article-kicker zj-article-kicker-weekly">Weekly Links</p>
			<h1 class="zj-article-title">{title}</h1>
			<p class="zj-article-meta">
				<time datetime={date.toISOString()}>{formattedDate}</time>
				{tags.length > 0 && (
					<span class="zj-article-tags">
						{' · '}{tags.join(' · ')}
					</span>
				)}
			</p>
		</header>

		<div class="zj-prose">
			<Content components={{YouTube, a: ProseLink}} />
		</div>

		<StarDivider />

		<nav class="zj-article-nav" aria-label="More weekly links">
			{older ? (
				<a class="zj-nav-older" href={`/1/weekly-links/${older.slug}`}>
					<span class="zj-nav-label">Older</span>
					{older.title}
				</a>
			) : (
				<span></span>
			)}
			<a class="zj-nav-index" href="/1">Index</a>
			{newer ? (
				<a class="zj-nav-newer" href={`/1/weekly-links/${newer.slug}`}>
					<span class="zj-nav-label">Newer</span>
					{newer.title}
				</a>
			) : (
				<span></span>
			)}
		</nav>
	</article>
</Layout>
