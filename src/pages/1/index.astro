---
import {compareDesc} from 'date-fns'
import {getAllPosts, getAllWeeklyLinks} from '../../lib/content'
import siteMeta from '../../config/siteMeta'
import Layout from '../../designs/zellij/Layout.astro'
import Star from '../../designs/zellij/Star.astro'
import StarDivider from '../../designs/zellij/StarDivider.astro'

const {social, talks, interviews, projects} = siteMeta

const byDateDesc = ({date: a}: {date: string}, {date: b}: {date: string}) =>
	compareDesc(new Date(a), new Date(b))

const posts = (await getAllPosts()).sort(byDateDesc)
const weeklyLinks = (await getAllWeeklyLinks()).sort(byDateDesc)

interface TalkItem {
	date: string
	title: string
	url: string
	slides?: string
}

const talkItems: TalkItem[] = [
	{
		date: '2024-03-03',
		title: 'Staff Engineering path (Arabic)',
		url: interviews.ahmedelemam[1],
	},
	{
		date: '2021-01-23',
		title: 'Null++ Podcast (Arabic)',
		url: interviews.nullplusplus[1],
	},
	{
		date: '2018-12-17',
		title: 'DevToManager Interview',
		url: interviews.devtomanager[1],
	},
	{
		date: '2017-06-08',
		title: 'Automating front-end refactoring',
		url: `https://www.youtube.com/watch?v=${talks.AmsterdamJS[1]}`,
		slides: talks.AmsterdamJS[0],
	},
]
---

<Layout title={siteMeta.title} hero>
	<section class="zj-section" aria-label="About">
		<p class="zj-lead">
			Software engineer with 15+ years of experience across Product,
			Platform, and Developer Experience. I focus on clarity,
			maintainability, and helping teams and individuals grow steadily over
			time.
		</p>
		<p class="zj-lead">
			Principal Engineer at{' '}
			<a target="_blank" rel="noreferrer noopener" href="https://miro.com">Miro</a>, Amsterdam.
		</p>
		<ul class="zj-social">
			{Object.entries(social).map(([site, entry]) => (
				<li>
					<a href={entry.url} rel="noopener noreferrer me" target="_blank">
						{'name' in entry ? entry.name : site}
					</a>
				</li>
			))}
		</ul>
	</section>

	<StarDivider />

	<section class="zj-section" aria-labelledby="projects">
		<h2 class="zj-section-title" id="projects">Projects</h2>
		<ul class="zj-entries">
			{projects.map((project) => (
				<li class="zj-entry">
					<span class="zj-entry-star" aria-hidden="true"><Star size={10} /></span>
					<span class="zj-entry-title">
						<a href={project.url} target="_blank" rel="noreferrer noopener">{project.name}</a>
					</span>
					<p class="zj-entry-desc">{project.description}</p>
				</li>
			))}
		</ul>
	</section>

	<StarDivider />

	<section class="zj-section" aria-labelledby="talks">
		<h2 class="zj-section-title" id="talks">Talks &amp; Interviews</h2>
		<ul class="zj-entries">
			{talkItems.map((item) => (
				<li class="zj-entry zj-entry-dated">
					<span class="zj-entry-star" aria-hidden="true"><Star size={10} /></span>
					<time class="zj-entry-date" datetime={item.date}>{item.date}</time>
					<span class="zj-entry-title">
						<a href={item.url} target="_blank" rel="noreferrer noopener">{item.title}</a>
						{item.slides && (
							<span class="zj-entry-extra">
								{' ('}<a href={item.slides} target="_blank" rel="noreferrer noopener">slides</a>{')'}
							</span>
						)}
					</span>
				</li>
			))}
		</ul>
	</section>

	<StarDivider />

	<section class="zj-section" aria-labelledby="blog">
		<h2 class="zj-section-title" id="blog">Blog</h2>
		<ul class="zj-entries">
			{posts.map((post) => (
				<li class="zj-entry zj-entry-dated">
					<span class="zj-entry-star" aria-hidden="true"><Star size={10} /></span>
					<time class="zj-entry-date" datetime={post.date}>{post.formattedDate}</time>
					<span class="zj-entry-title">
						<a href={`/1/blog/${post.slug}`}>{post.title}</a>
					</span>
				</li>
			))}
		</ul>
	</section>

	<StarDivider />

	<section class="zj-section" aria-labelledby="weekly-links">
		<h2 class="zj-section-title" id="weekly-links">Weekly Links</h2>
		<ul class="zj-entries">
			{weeklyLinks.map((post) => (
				<li class="zj-entry zj-entry-dated zj-entry-weekly">
					<span class="zj-entry-star" aria-hidden="true"><Star size={10} /></span>
					<time class="zj-entry-date" datetime={post.date}>{post.formattedDate}</time>
					<span class="zj-entry-title">
						<a href={`/1/weekly-links/${post.slug}`}>{post.title}</a>
					</span>
				</li>
			))}
		</ul>
	</section>
</Layout>
