---
import {render} from 'astro:content'
import {format} from 'date-fns'
import {
	byDateDesc,
	getAllPosts,
	getBlogEntry,
	getBlogStaticPaths,
	generateExcerpt,
} from '../../lib/content'
import siteMeta from '../../config/siteMeta'
import Layout from '../../layouts/Layout.astro'
import Arch from '../../components/Arch.astro'
import StarDivider from '../../components/StarDivider.astro'
import ProseLink from '../../components/ProseLink.astro'
import YouTube from '../../components/YouTube'

export const getStaticPaths = getBlogStaticPaths

const {slug} = Astro.params
const entry = await getBlogEntry(slug!)

if (!entry || !entry.data.published) {
	return Astro.redirect('/404')
}

const {title, date, tags} = entry.data
const excerpt = entry.data.excerpt || generateExcerpt(entry.body)
const formattedDate = format(date, 'yyyy-MM-dd')
const postUrl = `${siteMeta.siteUrl}/blog/${slug}`

const {twitter} = siteMeta.social
/* `via` wants the bare handle, so the display form's leading @ has to go */
const shareParams = new URLSearchParams({
	url: postUrl,
	via: twitter.display.slice(1),
	text: title,
})
const shareUrl = `https://twitter.com/share?${shareParams.toString()}`

const posts = (await getAllPosts()).sort(byDateDesc)
const index = posts.findIndex((post) => post.slug === slug)
const newer = index > 0 ? posts[index - 1] : null
const older =
	index >= 0 && index < posts.length - 1 ? posts[index + 1] : null

const {Content} = await render(entry)
---

<Layout
	title={title}
	description={excerpt}
	canonicalUrl={postUrl}
	ogType="article"
	slug={slug}
	publishedTime={date}
	markdownUrl={`/blog/${slug}.md`}
>
	<article class="zj-article">
		<header class="zj-article-header">
			<Arch />
			<p class="zj-article-kicker">Blog</p>
			<h1 class="zj-article-title">{title}</h1>
			<p class="zj-article-meta">
				<time datetime={date.toISOString()}>{formattedDate}</time>
				{tags.length > 0 && (
					<span class="zj-article-tags">
						{' · '}{tags.join(' · ')}
					</span>
				)}
			</p>
		</header>

		<div class="zj-prose">
			<Content components={{YouTube, a: ProseLink}} />
		</div>

		<StarDivider />

		<p class="zj-colophon">
			You can{' '}
			<a href={shareUrl} target="_blank" rel="noreferrer noopener">share this post</a>{' '}
			or reach me on{' '}
			<a href={twitter.url} target="_blank" rel="noreferrer noopener">{twitter.display}</a>.
		</p>

		<nav class="zj-article-nav" aria-label="More posts">
			{older ? (
				<a href={`/blog/${older.slug}`}>
					<span class="zj-nav-label">Older</span>
					{older.title}
				</a>
			) : (
				<span></span>
			)}
			<a class="zj-nav-index" href="/">Index</a>
			{newer ? (
				<a class="zj-nav-newer" href={`/blog/${newer.slug}`}>
					<span class="zj-nav-label">Newer</span>
					{newer.title}
				</a>
			) : (
				<span></span>
			)}
		</nav>
	</article>
</Layout>
