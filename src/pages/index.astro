---
import {byDateDesc, getAllPosts} from '../lib/content'
import siteMeta from '../config/siteMeta'
import Layout from '../layouts/Layout.astro'
import Star from '../components/Star.astro'
import StarDivider from '../components/StarDivider.astro'
import {role, summary, talkItems} from '../lib/homepage'

const {social, projects} = siteMeta

const posts = (await getAllPosts()).sort(byDateDesc)
---

<Layout hero markdownUrl="/index.md">
	<section class="zj-section" aria-label="About">
		<p class="zj-lead">{summary}</p>
		<p class="zj-lead">
			{role.title} at{' '}
			<a target="_blank" rel="noreferrer noopener" href={role.companyUrl}>{role.company}</a>, {role.location}.
		</p>
		<ul class="zj-social">
			{Object.entries(social).map(([site, entry]) => (
				<li>
					<a href={entry.url} rel="noopener noreferrer me" target="_blank">
						{'name' in entry ? entry.name : site}
					</a>
				</li>
			))}
		</ul>
	</section>

	<StarDivider />

	<section class="zj-section" aria-labelledby="projects">
		<h2 class="zj-section-title" id="projects">Projects</h2>
		<ul class="zj-entries">
			{projects.map((project) => (
				<li class="zj-entry">
					<span class="zj-entry-star" aria-hidden="true"><Star size={10} /></span>
					<span class="zj-entry-title">
						<a href={project.url} target="_blank" rel="noreferrer noopener">{project.name}</a>
					</span>
					<p class="zj-entry-desc">{project.description}</p>
				</li>
			))}
		</ul>
	</section>

	<StarDivider />

	<section class="zj-section" aria-labelledby="blog">
		<h2 class="zj-section-title" id="blog">Blog</h2>
		<ul class="zj-entries">
			{posts.map((post) => (
				<li class="zj-entry zj-entry-dated">
					<span class="zj-entry-star" aria-hidden="true"><Star size={10} /></span>
					<time class="zj-entry-date" datetime={post.date}>{post.formattedDate}</time>
					<span class="zj-entry-title">
						<a href={`/blog/${post.slug}`}>{post.title}</a>
					</span>
				</li>
			))}
		</ul>
	</section>

	<StarDivider />

	<section class="zj-section" aria-labelledby="talks">
		<h2 class="zj-section-title" id="talks">Talks &amp; Interviews</h2>
		<ul class="zj-entries">
			{talkItems.map((item) => (
				<li class="zj-entry zj-entry-dated">
					<span class="zj-entry-star" aria-hidden="true"><Star size={10} /></span>
					<time class="zj-entry-date" datetime={item.date}>{item.date}</time>
					<span class="zj-entry-title">
						<a href={item.url} target="_blank" rel="noreferrer noopener">{item.title}</a>
						{item.slides && (
							<span class="zj-entry-extra">
								{' ('}<a href={item.slides} target="_blank" rel="noreferrer noopener">slides</a>{')'}
							</span>
						)}
					</span>
				</li>
			))}
		</ul>
	</section>
</Layout>
