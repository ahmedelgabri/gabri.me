---
import siteMeta from '../config/siteMeta'
import Astrolabe from '../components/Astrolabe.astro'
import GirihFrieze from '../components/GirihFrieze.astro'
import NightSky from '../components/NightSky.astro'
import Observatory from '../components/Observatory.astro'
import Pencil from '../components/Pencil.astro'
import Star from '../components/Star.astro'
/* Astro emits a component's own <style> after its imports, so the base sheet
 * keeps its place at the end of the cascade only by being imported last */
import '../styles/global.css'

interface Props {
	title?: string
	description?: string
	canonicalUrl?: string
	ogType?: 'website' | 'article'
	slug?: string
	publishedTime?: Date
	hero?: boolean
}

const {
	title,
	description = siteMeta.description,
	canonicalUrl,
	ogType = 'website',
	slug,
	publishedTime,
	hero = false,
} = Astro.props

const {author, siteUrl, social, twitterId} = siteMeta

const fullTitle = title
	? `${author} | ${siteMeta.title} - ${title}`
	: `${author} | ${siteMeta.title}`

const canonical = canonicalUrl || Astro.url.href

/* Posts get a card rendered from their title; everything else shares the site's */
const ogImage =
	ogType === 'article' && slug ? `/og/${slug}.png` : '/img/fb-image.jpg'

const GA4_TRACKING_ID = import.meta.env.GA4_TRACKING_ID

const fontFamilies = [
	'Amiri:wght@400;700',
	'IBM+Plex+Mono:wght@400;600',
	'Spectral:ital,wght@0,400;0,600;1,400;1,600',
]

const fontsHref = `https://fonts.googleapis.com/css2?${fontFamilies
	.map((family) => `family=${family}`)
	.join('&')}&display=swap`

const year = new Date().getFullYear()
---

<!doctype html>
<html lang="en" class="light">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, viewport-fit=cover"
		/>
		<meta
			name="theme-color"
			media="(prefers-color-scheme: light)"
			content="#F5EEDF"
		/>
		<meta
			name="theme-color"
			media="(prefers-color-scheme: dark)"
			content="#132347"
		/>
		{/* The stylesheet re-declares this per theme; the meta covers the frames before it lands */}
		<meta name="color-scheme" content="light dark" />

		<title>{fullTitle}</title>
		<meta name="description" content={description} />

		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/icon.svg" type="image/svg+xml" sizes="any" />
		<link rel="shortcut icon" href="/icon.svg" type="image/svg+xml" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href={fontsHref} />

		<!-- OpenGraph -->
		<meta property="og:title" content={title || fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content={author} />
		<meta property="og:locale" content="en-US" />
		<meta property="og:image" content={`${siteUrl}${ogImage}`} />
		<meta property="og:type" content={ogType} />
		{ogType === 'article' && publishedTime && (
			<meta
				property="article:published_time"
				content={publishedTime.toISOString()}
			/>
		)}
		{ogType === 'article' && <meta property="article:author" content={author} />}

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site:id" content={twitterId} />
		<meta name="twitter:creator" content={social.twitter.display} />
		<meta name="twitter:creator:id" content={twitterId} />
		<meta name="twitter:title" content={title || fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

		<!-- Authors -->
		<link rel="author" href={siteUrl} />
		<meta name="author" content={author} />
		<meta name="creator" content={author} />
		<meta name="publisher" content={author} />
		<meta name="application-name" content="Gabri.me" />
		<meta name="fediverse:creator" content="@gabri@mastodon.online" />
		<meta name="mobile-web-app-capable" content="yes" />

		<!-- Apple -->
		<meta name="apple-mobile-web-app-title" content="Gabri.me" />
		<meta
			name="apple-mobile-web-app-status-bar-style"
			content="black-translucent"
		/>

		<!-- RSS -->
		<link
			rel="alternate"
			type="application/rss+xml"
			title={`${author} RSS Feed`}
			href={new URL('feed.xml', Astro.site)}
		/>

		<!-- Social links -->
		{Object.entries(social).map(([, {url}]) => <link href={url} rel="me" />)}

		<script is:inline>
			/* Runs before paint so the ivory/indigo swap never flashes */
			;(function () {
				var KEY = 'theme'
				var VALID = ['system', 'light', 'dark']
				var setting

				try {
					setting = localStorage.getItem(KEY)
				} catch (e) {}

				if (VALID.indexOf(setting) === -1) {
					setting = 'system'
				}

				var query = window.matchMedia('(prefers-color-scheme: dark)')

				/* The setting is this closure's own; only the resolved theme is published */
				function resolve() {
					return setting === 'system'
						? query.matches
							? 'dark'
							: 'light'
						: setting
				}

				/* The observatory is inert without this script, so it only appears once it runs */
				document.documentElement.classList.add('zj-js')

				function apply(theme) {
					var root = document.documentElement
					root.classList.remove('light', 'dark')
					root.classList.add(theme)
					window.__zjTheme = theme
					/* Everything that follows the sky hears this, system changes included */
					window.dispatchEvent(new CustomEvent('zj:theme'))
				}

				apply(resolve())

				window.__zjSetTheme = function (next) {
					setting = next
					try {
						localStorage.setItem(KEY, next)
					} catch (e) {}
					apply(resolve())
				}

				query.addEventListener('change', function () {
					if (setting === 'system') {
						apply(resolve())
					}
				})
			})()
		</script>

		{GA4_TRACKING_ID && (
			<>
				<script
					is:inline
					async
					src={`https://www.googletagmanager.com/gtag/js?id=${GA4_TRACKING_ID}`}
				></script>
				<script is:inline define:vars={{GA4_TRACKING_ID}}>
					window.dataLayer = window.dataLayer || []
					function gtag() {
						dataLayer.push(arguments)
					}
					gtag('js', new Date())
					gtag('config', GA4_TRACKING_ID, {
						page_path: window.location.pathname,
						anonymize_ip: true,
					})
				</script>
			</>
		)}
	</head>
	<body>
		<div class="zj-page">
			<Star class="zj-corner zj-corner-tl" size={18} />
			<Star class="zj-corner zj-corner-tr" size={18} />
			<Star class="zj-corner zj-corner-bl" size={18} />
			<Star class="zj-corner zj-corner-br" size={18} />

			<Observatory />

			<header class:list={['zj-masthead', {'zj-masthead-compact': !hero}]}>
				{
					hero ? (
						<h1 class="zj-name">Ahmed El Gabri</h1>
					) : (
						<p class="zj-name">
							<a href="/">Ahmed El Gabri</a>
						</p>
					)
				}
				<p class="zj-name-ar" lang="ar" dir="rtl">أحمد الجابري</p>
				{hero && <p class="zj-role">{siteMeta.title}</p>}
				<div class="zj-frieze-band">
					<GirihFrieze />
				</div>
			</header>

			<main class="zj-main">
				<slot />
			</main>

			<footer class="zj-footer">
				<Astrolabe />
				<p>© {year} Ahmed El Gabri</p>
			</footer>
		</div>
		{/* The lattice first, then the sky over it, as the CSS layers stack */}
		<Pencil />
		<NightSky />
	</body>
</html>
